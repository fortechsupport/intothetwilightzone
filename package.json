{
  "name": "intothetwilightzone",
  "private": true,
  "type": "module",
  "description": "IntoTheTwilightZone.com: a non-commercial fan site and living history of The Twilight Zone.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "astro dev",
    "import": "python3 scripts/import_spreadsheets.py",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "build:preview": "REVIEW_MODE=preview astro build && pagefind --site dist",
    "review:export": "python3 scripts/review.py export",
    "review:import": "python3 scripts/review.py import",
    "review:status": "python3 scripts/review.py status",
    "assess": "python3 scripts/assess.py",
    "dev:accounts": "astro build && wrangler d1 migrations apply intothetwilightzone --local && wrangler pages dev dist",
    "check:server": "tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "astro": "^7.4.13",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "pagefind": "^1.6.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0",
    "yaml": "^2.9.1"
  }
}
