{
  "$description": "Design tokens for IntoTheTwilightZone.com. The master copy: edit here, then run `npm run tokens` to regenerate public/tokens.css. The script fails if any text pair falls below 4.5:1 contrast (3:1 for large display text and control borders).",
  "themes": {
    "midnight": {
      "label": "Midnight (dark, the default)",
      "color": {
        "bg": "#08090f",
        "surface": "#10131c",
        "surface-2": "#171b27",
        "surface-3": "#1f2433",
        "line": "#262c3c",
        "line-strong": "#5e6885",
        "text": "#efeadf",
        "text-soft": "#cdc8bc",
        "muted": "#a5a9b6",
        "brass": "#e3b964",
        "brass-soft": "#b8954e",
        "on-brass": "#15110a",
        "link": "#9fc5ec",
        "link-hover": "#d5e7fa",
        "official": "#e3b964",
        "unofficial": "#bfaef0",
        "danger": "#f0a3a3",
        "ok": "#8fd6a8",
        "focus": "#f3cf7c",
        "map-1": "#8fb3d9", "map-2": "#d9c38f", "map-3": "#e58f8f", "map-4": "#c3b3e6", "map-5": "#7fd1b9", "map-6": "#f0a35e", "map-7": "#b0c4a0", "map-8": "#e6e9f0", "map-9": "#9aa3b8",
        "header-bg": "rgba(8, 9, 15, 0.92)",
        "shadow": "0 18px 40px rgba(0, 0, 0, 0.55)"
      }
    },
    "paper": {
      "label": "Paper (light)",
      "color": {
        "bg": "#f3eee2",
        "surface": "#fbf8f0",
        "surface-2": "#efe8d8",
        "surface-3": "#e6dcc6",
        "line": "#d9cfb8",
        "line-strong": "#8f8467",
        "text": "#1b1915",
        "text-soft": "#3a362e",
        "muted": "#5d574a",
        "brass": "#7d5300",
        "brass-soft": "#9a6a12",
        "on-brass": "#fffaf0",
        "link": "#1c4e85",
        "link-hover": "#0d2f57",
        "official": "#7d5300",
        "unofficial": "#5a3fa8",
        "danger": "#a12b2b",
        "ok": "#1f6b3c",
        "focus": "#1c4e85",
        "map-1": "#8fb3d9", "map-2": "#d9c38f", "map-3": "#e58f8f", "map-4": "#c3b3e6", "map-5": "#7fd1b9", "map-6": "#f0a35e", "map-7": "#b0c4a0", "map-8": "#e6e9f0", "map-9": "#9aa3b8",
        "header-bg": "rgba(243, 238, 226, 0.94)",
        "shadow": "0 18px 40px rgba(60, 45, 10, 0.18)"
      }
    }
  },
  "contrast": {
    "text": [["text", "bg"], ["text", "surface"], ["text", "surface-2"], ["text", "surface-3"], ["text-soft", "surface"], ["text-soft", "surface-2"],
             ["muted", "bg"], ["muted", "surface"], ["muted", "surface-2"], ["link", "bg"], ["link", "surface"], ["link", "surface-2"],
             ["brass", "bg"], ["brass", "surface"], ["brass", "surface-2"], ["on-brass", "brass"], ["official", "surface-2"], ["unofficial", "surface-2"],
             ["danger", "surface"], ["ok", "surface"]],
    "ui": [["line-strong", "bg"], ["line-strong", "surface"], ["focus", "bg"], ["focus", "surface"]]
  },
  "font": {
    "display": "'DM Serif Display', 'Iowan Old Style', Georgia, serif",
    "ui": "'Jost', 'Futura', 'Century Gothic', system-ui, sans-serif",
    "mono": "'Courier Prime', 'Courier New', Courier, monospace"
  },
  "size": {
    "step--2": "0.75rem", "step--1": "0.875rem", "step-0": "1.0625rem", "step-1": "1.25rem", "step-2": "1.5rem",
    "step-3": "clamp(1.6rem, 1.3rem + 1.4vw, 2.1rem)", "step-4": "clamp(2rem, 1.5rem + 2.6vw, 3rem)", "step-5": "clamp(2.4rem, 1.6rem + 4.2vw, 4.4rem)"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px" },
  "radius": { "sm": "4px", "md": "8px", "lg": "14px", "pill": "999px" },
  "layout": { "page": "1200px", "measure": "68ch", "header": "64px" }
}
