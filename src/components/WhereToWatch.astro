---
// "Where to watch" for a series or show (Adam, 2026-11-21): on every series, show, film and episode page.
// US offers from data/fan/watch.yaml with the date JustWatch checked them; a show we haven't checked gets
// search links instead. Service names only, plain links, no affiliate codes.
//   as="fact"    a <dt>/<dd> pair for a page's dl.facts, near the top (series, film and episode pages)
//   as="section" its own section with a heading (show pages without a facts list)
// `note` adds a lead-in (an episode page names its season).
import { longDate, type WatchInfo } from '../lib/watch';
interface Props { info: WatchInfo; note?: string; as?: 'fact' | 'section' }
const { info, note, as = 'fact' } = Astro.props;
const w = info.w;
const none = w && !w.stream.length && !w.free.length && !w.buy.length;
const when = w ? longDate(w.checked ?? w.fetched) : '';
const groups: [string, string[]][] = w ? ([['Stream', w.stream], ['Free with ads', w.free], ['Buy or rent', w.buy]] as [string, string[]][]).filter(([, l]) => l.length) : [];
---
{as === 'fact' ? (
  <>
    <dt>Where to watch</dt>
    <dd class="watch-dd" data-pagefind-ignore>
      {note && <>{note} </>}
      {groups.map(([k, l], i) => <>{i > 0 && ' · '}<strong>{k}:</strong> {l.join(', ')}</>)}
      {none && 'Not streaming or for sale in the US.'}
      {!w && 'Not checked yet.'}
      <span class="small muted watch-src">
        {w ? <> US, as of {when} · <a href={w.justwatch}>JustWatch</a> · <a href={info.search.reelgood}>Reelgood</a></> : <> Search <a href={info.search.justwatch}>JustWatch</a> or <a href={info.search.reelgood}>Reelgood</a></>}
      </span>
    </dd>
  </>
) : (
  <section class="where-to-watch" id="watch" data-pagefind-ignore>
    <h2>Where to watch</h2>
    {note && <p>{note}</p>}
    {groups.length > 0 && <dl class="facts watch-facts">{groups.map(([k, l]) => <><dt>{k}</dt><dd>{l.join(', ')}</dd></>)}</dl>}
    {none && <p>Not streaming or for sale in the US when JustWatch last checked.</p>}
    {!w && <p>We haven’t checked this one yet.</p>}
    <p class="small">
      {w ? <>In the US, as of {when}. Today’s options: <a href={w.justwatch}>JustWatch</a> · <a href={info.search.reelgood}>Reelgood</a></> : <>Search <a href={info.search.justwatch}>JustWatch</a> or <a href={info.search.reelgood}>Reelgood</a></>}
    </p>
    <p class="small muted">Plain links, no affiliate codes: this site earns nothing from them.</p>
  </section>
)}
