---
import LinkVote from './fan/LinkVote.astro';
// The body of a film-record page: every screen work with a page of its own, and every show page
// (a tv-series record), which also lists its episodes, segments and sketches in the episode explorer.
import TrackButtons from './fan/TrackButtons.astro';
import { trackFor } from '../lib/fan/contribute';
import RecordHeader from './RecordHeader.astro';
import { recordType, recordContext } from '../lib/titles';
import InCategories from './InCategories.astro';
import Media from './Media.astro';
import Related from './Related.astro';
import Sources from './Sources.astro';
import HistoryAndIntl from './HistoryAndIntl.astro';
import EpisodeExplorer from './EpisodeExplorer.astro';
import WhereToWatch from './WhereToWatch.astro';
import { watchFor } from '../lib/watch';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatDate, personUrl, resolveRef, CONNECTION_LABELS, CONFIDENCE_LABELS } from '../lib/data';
import { tv, explorerEntries } from '../lib/television';
import ThemeList from './ThemeList.astro';
import { segmentThemes, inheritedThemes, topThemes, ordered } from '../lib/themes';
import { assess, TIER_LABEL } from '../lib/assessments';
import { catalog, placesOf } from '../lib/catalog';
import { shortSource, CONNECTION_VERBS } from '../lib/data';

interface Props { f: CollectionEntry<'films'>; title?: string }
const { f, title } = Astro.props;
const d = f.data;
const conns = (await getCollection('connections')).filter((c) => c.data.from === `films/${f.id}`);
const targets = await Promise.all(conns.map(async (c) => ({ c, ep: await resolveRef(c.data.to) })));
const show = d.kind === 'tv-series' ? tv.showByRecord(f.id) : undefined;
const entries = show ? await explorerEntries(show.entries) : [];
const nouns = entries.every((e) => e.kindLabel === 'Sketch') ? 'sketches' : 'episodes';
const a = assess(`films/${f.id}`);
// Themes (decision 0004): a show's most common, a film's own segments', or those of the episodes it points to.
const segThemes = d.segments.map((_, i) => segmentThemes(f.id, i));
const showThemes = topThemes(entries.map((e) => e.themes), 6);
const ownThemes = ordered(segThemes.flat());
const pointsTo = conns.map((c) => c.data.to).filter((t) => /^\d{4}\//.test(t));
const inherited = ownThemes.length ? [] : await inheritedThemes(pointsTo);
const fromSegs = entries.some((e) => e.themesFrom === 'segments');
const TAGS: Record<string, string> = { 'anthology-family': 'Fellow anthology', 'tz-writers': 'Made by Twilight Zone writers', 'tz-makers': 'By Twilight Zone makers', 'fan-made': 'Fan-made', 'radio-only': 'Radio only', 'compared-by-critics': 'Compared by critics', 'cited-by-makers': 'Cited by its makers' };
const tags = (d.tags ?? []).map((t: string) => TAGS[t]).filter(Boolean);
const host = d.parent_series ? tv.showOf(f.id) : undefined;
// The shelf this record sits on, for "More on this shelf" and previous/next.
const shelf = (await placesOf(`films/${f.id}`))[0];
const shelfEntries = shelf ? ((await catalog()).get(shelf.cat)?.subs.find((x) => x.slug === shelf.sub)?.entries ?? []) : [];
const at = shelfEntries.findIndex((e) => e.key === `films/${f.id}`);
const prevE = at > 0 ? shelfEntries[at - 1] : undefined;
const nextE = at >= 0 && at < shelfEntries.length - 1 ? shelfEntries[at + 1] : undefined;
// Serling's part in it, for the films on "Rod Serling's films" (field serling_role).
const SERLING_PART: Record<string, string> = {
  written: 'Rod Serling wrote it.',
  'from-his-work': 'It was made from Rod Serling’s work.',
  narrated: 'Rod Serling narrates it.',
  appeared: 'Rod Serling appears in it.',
};
const serlingRole = d.serling_role ? SERLING_PART[d.serling_role] : undefined;
const firstLabel = d.kind === 'tv-series' ? 'First aired' : d.kind === 'stage' ? 'First performed' : 'Released';
// A segment's episode by its title, not its address.
const segEps = await Promise.all(d.segments.map((sg) => (sg.adapts_episode ? resolveRef(sg.adapts_episode) : Promise.resolve(undefined))));
// A play (kind stage): the production records that belong to it (Stage plan, shelf A).
const productions = d.kind === 'stage' ? (await getCollection('works')).filter((w) => !w.data.duplicate_of && w.data.kind === 'stage' && w.data.content_of.includes(`films/${f.id}`)) : [];
// A music video: the song's own page, when the song is recorded (Music plan: each video shows on its song's page).
const normT = (x: string) => x.toLowerCase().replace(/[^a-z0-9]+/g, '');
const songs = d.kind === 'music-video' ? (await getCollection('songs')).filter((s) => !s.data.duplicate_of && normT(`${s.data.title} (${s.data.artist ?? ''})`) === normT(d.title)) : [];
// Where to watch, for anything made for the screen that still exists (not radio, pilots never aired or unmade work).
const WATCHABLE = new Set(['tv-series', 'film', 'documentary', 'tv-film', 'special', 'short']);
const jw = d.links?.justwatch ? (d.links.justwatch.startsWith('http') ? d.links.justwatch : `https://www.justwatch.com/us/movie/${d.links.justwatch}`) : undefined;
const watch = WATCHABLE.has(d.kind) && !(d.tags ?? []).includes('radio-only') && !d.parent_series
  ? watchFor(d.kind === 'tv-series' ? { slug: show?.slug ?? `film-${f.id}`, name: show?.title ?? d.title, justwatch: jw } : { name: d.title, slug: `film-${f.id}`, justwatch: jw })
  : undefined;
---
  <InCategories recKey={`films/${f.id}`} />
  <RecordHeader type={recordType('films', d)} context={recordContext('films', d)} title={title ?? d.title} recKey={`films/${f.id}`} />
  {(() => { const t = trackFor('films', (d as any).kind); return (t.seen || t.own) && <TrackButtons recKey={`films/${f.id}`} seen={t.seen} own={t.own} />; })()}
  {d.parent_series && <p class="muted">{host ? <a href={host.href}>{d.parent_series}</a> : d.parent_series}</p>}
  {d.aka.length > 0 && <p class="muted">Also known as {d.aka.join(', ')}</p>}
  {d.summary && <p class="lead">{d.summary}</p>}
  <dl class="facts">
    {d.kind === 'tv-series' && d.release_date ? <><dt>On the air</dt><dd>{formatDate(d.release_date)}{d.end_date ? ` to ${formatDate(d.end_date)}` : ''}</dd></> : d.release_date && <><dt>{firstLabel}</dt><dd>{formatDate(d.release_date)}</dd></>}
    {d.network && <><dt>Network</dt><dd>{d.network}</dd></>}
    {d.country && <><dt>Country</dt><dd>{d.country}</dd></>}
    {(d.seasons || d.episode_count) && <><dt>Episodes</dt><dd>{[d.episode_count && `${d.episode_count}`, d.seasons && `in ${d.seasons} ${d.seasons === 1 ? 'season' : 'seasons'}`].filter(Boolean).join(' ')}</dd></>}
    {d.created_by.length > 0 && <><dt>Created by</dt><dd>{d.created_by.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</dd></>}
    {d.presented_by.length > 0 && <><dt>Hosted by</dt><dd>{d.presented_by.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</dd></>}
    {tags.length > 0 && <><dt>Tagged</dt><dd>{tags.map((t: string) => <span class="tag">{t}</span>)}</dd></>}
    {d.rating && <><dt>Rating</dt><dd>{d.rating}</dd></>}
    {showThemes.length > 0 ? <ThemeList slugs={showThemes.map(([t]) => t)} counts={new Map(showThemes)} label="Most common themes" from={fromSegs ? 'its segments, with how many episodes carry each' : 'the Twilight Zone episodes its episodes point to, with how many'} />
      : ownThemes.length > 0 ? <ThemeList slugs={ownThemes} from="its segments" />
      : <ThemeList slugs={inherited} from={pointsTo.length > 1 ? 'the Twilight Zone episodes it points to' : 'the Twilight Zone episode it points to'} />}
    {watch && <WhereToWatch info={watch} />}
    {d.runtime_min && <><dt>Runtime</dt><dd>{d.runtime_min} minutes</dd></>}
    {d.directors.length > 0 && <><dt>Directed by</dt><dd>{d.directors.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</dd></>}
    {d.writers.length > 0 && <><dt>Written by</dt><dd>{d.writers.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}{d.writing_credit_note && <div class="small muted">{d.writing_credit_note}</div>}</dd></>}
    {(d.source_title || d.source_authors.length > 0) && <><dt>Based on</dt><dd>{d.source_title ? `“${d.source_title}”` : 'A story'}{d.source_authors.length > 0 && <> by {d.source_authors.map((n, i) => <>{i > 0 && (i === d.source_authors.length - 1 ? ' and ' : ', ')}<a href={personUrl(n)}>{n}</a></>)}</>}</dd></>}
    {d.composer.length > 0 && <><dt>Music by</dt><dd>{d.composer.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</dd></>}
    {songs.length > 0 && <><dt>Song</dt><dd>{songs.map((s, i) => <>{i > 0 && ', '}<a href={`/songs/${s.id}/`}>{s.data.title}</a>{s.data.artist && ` by ${s.data.artist}`}</>)}</dd></>}
  </dl>
  {d.segments.length > 0 && (
    <section>
      <h2>{d.kind === 'stage' ? 'Stories it adapts' : 'Segments'}</h2>
      <ul class="plain">
        {d.segments.map((sg, si) => (
          <li>
            {sg.adapts_episode && segEps[si] && segEps[si]!.title === sg.title
              ? <strong><a href={segEps[si]!.url}>{sg.title}</a></strong>
              : <><strong>{sg.title}</strong>{sg.adapts_episode && <> · adapts <a href={segEps[si]?.url ?? `/episodes/${sg.adapts_episode}/`}>{segEps[si]?.title ?? sg.adapts_episode.split('/')[1].replace(/-/g, ' ')}</a></>}</>}
            {sg.summary && <p class="small">{sg.summary}</p>}
            <ThemeList slugs={segThemes[si]} as="line" />
            {sg.source_title && <div class="small">Based on “{sg.source_title}”{sg.source_authors.length > 0 && <> by {sg.source_authors.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</>}</div>}
            {sg.directors.length > 0 && <div class="small">Directed by {sg.directors.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</div>}
            {sg.writers.length > 0 && <div class="small">Written by {sg.writers.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</div>}
            {sg.cast.length > 0 && <div class="small">Cast: {sg.cast.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</div>}
          </li>
        ))}
      </ul>
    </section>
  )}
  {(a || d.ties.length > 0 || targets.length > 0 || serlingRole) && (
    <aside class="tz-link">
      <h2>Why it’s here</h2>
      {a && !(d.summary && a.connection.includes(d.summary.slice(0, 40))) && <p>{a.connection}</p>}
      {serlingRole && <p>{serlingRole}</p>}
      {targets.length > 0 && (
        <ul class="ties">
          {targets.map(({ c, ep }) => (
            <li>
              {CONNECTION_VERBS[c.data.kind] ?? CONNECTION_LABELS[c.data.kind]} {ep ? <a href={ep.url}>{ep.title}</a> : c.data.to}{ep && ep.kind !== 'Series' && <span class="muted small"> · {ep.kind}</span>}
              {' '}<span class={`tag ${c.data.confidence}`}>{CONFIDENCE_LABELS[c.data.confidence]}</span> <LinkVote id={c.id} />
              {c.data.evidence && <p class="small">{c.data.evidence}</p>}
              {c.data.sources.length > 0 && <span class="small muted"> ({c.data.sources.map((x, i) => <>{i > 0 && ', '}{x.url ? <a href={x.url} rel="noopener" title={x.title}>{shortSource(x)}</a> : shortSource(x)}</>)})</span>}
            </li>
          ))}
        </ul>
      )}
      {d.ties.length > 0 && <ul class="ties">{d.ties.map((t) => <li>{t.text} <span class="small muted">({t.sources.map((x, i) => <>{i > 0 && ', '}{x.url ? <a href={x.url} rel="noopener" title={x.title}>{shortSource(x)}</a> : shortSource(x)}</>)})</span></li>)}</ul>}
      {a && <p class="small muted">{TIER_LABEL[a.tier]}: {a.tier_reason}{a.source_url && <> <a href={a.source_url} rel="noopener" title={a.source_title}>{shortSource({ title: a.source_title, url: a.source_url })}</a></>}</p>}
    </aside>
  )}
  <slot />
  {entries.length > 0 && (
    <section>
      <h2>{nouns === 'sketches' ? 'Sketches' : 'Episodes'} <span class="muted small">({entries.length})</span></h2>
      <EpisodeExplorer entries={entries} noun={nouns} />
    </section>
  )}
  <slot name="after" />
  <HistoryAndIntl history={d.history} intl={d.international_titles} releases={d.releases} historyTitle={d.kind === 'stage' ? 'Productions' : undefined} />
  {productions.length > 0 && (
    <section>
      <h2>Production pages</h2>
      <ul class="plain">{productions.map((w) => <li><a href={`/works/${w.id}/`}>{w.data.title}</a>{w.data.description && <span class="small"> {w.data.description.split(/(?<=\.)\s/)[0]}</span>}</li>)}</ul>
    </section>
  )}
  {(d.ids?.imdb || d.links?.wikipedia || d.links?.trailer_youtube || d.links?.justwatch) && <section>
    <h2>Links</h2>
    <ul>
      {d.ids?.imdb && <li><a href={`https://www.imdb.com/title/${d.ids.imdb}/`} rel="noopener">IMDb</a></li>}
      {d.links?.wikipedia && <li><a href={d.links.wikipedia} rel="noopener">Wikipedia</a></li>}
      {d.links?.trailer_youtube && <li><a href={`https://www.youtube.com/watch?v=${d.links.trailer_youtube}`} rel="noopener">Trailer</a></li>}
    </ul>
  </section>}
  <Related recKey={`films/${f.id}`} skip={['people']} />
  <Media media={d.media} recKey={`films/${f.id}`} />
  <Sources sources={d.sources} verified={d.last_verified} />
  {shelf && shelfEntries.length > 1 && (
    <nav class="pager" aria-label={`More in ${shelf.subTitle}`} data-pagefind-ignore>
      <span>{prevE?.href && <a href={prevE.href} rel="prev">← {prevE.title}</a>}</span>
      <a href={shelf.href}>{shelf.subTitle} ({shelfEntries.length})</a>
      <span>{nextE?.href && <a href={nextE.href} rel="next">{nextE.title} →</a>}</span>
    </nav>
  )}
