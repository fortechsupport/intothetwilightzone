---
interface Props { sources: { title: string; url?: string; author?: string; publisher?: string; note?: string }[]; verified?: string }
const { sources, verified } = Astro.props;
import { correctionUrl } from '../lib/fan/contribute';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = Astro.url.pathname.replace(/^\/|\/$/g, '');
---
<section class="sources" data-pagefind-ignore>
  <h2>Sources</h2>
  {sources.length === 0 ? <p class="muted">No sources recorded yet.</p> : (
    <ul class="small">
      {sources.map((s) => (
        <li>{s.author && <>{s.author}, </>}{s.url ? <a href={s.url} rel="noopener">{s.title}</a> : s.title}{s.publisher && <span class="muted"> ({s.publisher})</span>}{s.note && <span class="muted"> · {s.note}</span>}</li>
      ))}
    </ul>
  )}
  <p class="small muted">{verified ? `Last verified ${verified}.` : 'Not yet verified.'} <a href={correctionUrl(pageUrl, pageTitle)} rel="noopener">Suggest a correction</a> or <a href="/contribute/">send us something new</a>.</p>
</section>
