---
// A list of catalogue entries: title (linked), one line of facts, a description and the
// "Twilight Zone connection" line. `compact` renders names only, in columns (people, media).
import type { Entry } from '../lib/catalog';
interface Props { entries: Entry[]; compact?: boolean }
const { entries, compact = false } = Astro.props;
// Data for ListTools (search, filter and sort on list pages): sort key, year, shelf, relevance and group.
const year = (e: Entry) => String(e.meta ?? '').match(/\b(1[89]\d\d|20\d\d)\b/)?.[1] ?? '';
// Empty values are left out to keep long pages light; ListTools reads a missing tier as core.
const attrs = (e: Entry) => {
  // Compact lists sort by their visible text (ListTools falls back to it) to keep the page light.
  const a: Record<string, string> = compact ? { 'data-lt': '' } : { 'data-lt': '', 'data-sort': e.sort };
  const y = year(e); if (y) a['data-year'] = y;
  if (e.official === true) a['data-side'] = 'official'; else if (e.official === false) a['data-side'] = 'unofficial';
  if (e.tier && e.tier !== 'core') a['data-tier'] = e.tier;
  if (e.group) a['data-group'] = e.group;
  return a;
};
---
{compact ? (
  <ul class="columns plain entries-compact">
    {entries.map((e) => (
      <li {...attrs(e)}>{e.href ? <a href={e.href} rel={e.external ? 'noopener' : undefined}>{e.title}</a> : e.title}{e.meta && <span class="muted small"> · {e.meta}</span>}{e.tier && e.tier !== 'core' && <span class={`tag tier-${e.tier}`}>{e.tier}</span>}</li>
    ))}
  </ul>
) : (
  <ul class="entries">
    {entries.map((e) => (
      <li {...attrs(e)}>
        <div class="entry-head">
          {e.href ? <a href={e.href} class="entry-title" rel={e.external ? 'noopener' : undefined}>{e.title}</a> : <span class="entry-title">{e.title}</span>}
          {e.meta && <span class="muted small"> · {e.meta}</span>}
          {e.tier && e.tier !== 'core' && <span class={`tag tier-${e.tier}`}>{e.tier}</span>}
          {e.external && <span class="tag">external</span>}
        </div>
        {e.desc && <p class="entry-desc">{e.desc}</p>}
        {e.why && e.why !== e.desc && <p class="entry-why small"><strong>Why it’s here:</strong> {e.why}</p>}
      </li>
    ))}
  </ul>
)}
