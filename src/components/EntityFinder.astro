---
// For a section too large for one page (People): the most connected entries are listed here, and the
// filters search the whole index by loading /<section>/index.json only when a visitor uses them.
// ?in=, ?role= and ?q= preset the filters, as on EntityIndex. Without JavaScript, the A to Z letter
// pages hold every entry.
import { entityRows, catalog } from '../lib/catalog';
interface Props { section: 'people' | 'places' | 'organizations'; noun: string; top?: number }
const { section, noun, top = 60 } = Astro.props;
const rows = await entityRows(section);
const cats = [...(await catalog()).values()].filter((c) => !c.kind);
const used = new Set(rows.flatMap((r) => r.where.map((w) => w.slug)));
const subs = (await catalog()).get(section)!.subs.filter((s) => s.entries.length);
const most = [...rows].sort((a, b) => b.records - a.records || a.sort.localeCompare(b.sort)).slice(0, top);
const tops = (r: (typeof rows)[number]) => r.where.filter((w) => !w.slug.includes('/'));
---
<form class="lib-filters" data-pagefind-ignore onsubmit="return false" data-finder={`/${section}/index.json`}>
  <label>Kind <select id="e-role"><option value="">All</option>{subs.map((s) => <option value={s.slug}>{s.title}</option>)}</select></label>
  <label>Appears in <select id="e-in"><option value="">Anywhere</option>{cats.map((c) => used.has(c.slug) && <><option value={c.slug}>{c.title}</option>{c.subs.filter((s) => used.has(`${c.slug}/${s.slug}`)).map((s) => <option value={`${c.slug}/${s.slug}`}>&nbsp;&nbsp;{c.title}: {s.title}</option>)}</>)}</select></label>
  <label>Search <input id="e-q" type="search" placeholder={`Find ${noun}`} /></label>
  <span id="e-count" class="small muted" role="status">The {most.length} {noun} in the most records. Filter or search to see all {rows.length.toLocaleString('en-US')}.</span>
</form>
<div class="table-wrap">
  <table class="lib" id="ent">
    <thead><tr><th>Name</th><th>Kind</th><th>Records</th><th>Appears in</th></tr></thead>
    <tbody>
      {most.map((r) => (
        <tr>
          <td><a href={r.href}>{r.title}</a>{r.official === true && <span class="tag">Official</span>}{r.meta && <div class="small muted">{r.meta}</div>}</td>
          <td class="small">{r.subs.map((s) => s.title).join(', ')}</td>
          <td class="small">{r.records || ''}</td>
          <td class="small">{tops(r).map((w, i) => <>{i > 0 && ' · '}<a href={w.href}>{w.title}</a></>)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<script is:inline>
  (() => {
    const $ = (id) => document.getElementById(id);
    const form = document.querySelector('[data-finder]');
    const tbody = document.querySelector('#ent tbody');
    const initial = tbody.innerHTML;
    const initialCount = $('e-count').textContent;
    const p = new URLSearchParams(location.search);
    $('e-role').value = p.get('role') || ''; $('e-in').value = p.get('in') || ''; $('e-q').value = p.get('q') || '';
    let data, loading;
    const load = () => (loading ??= fetch(form.dataset.finder).then((r) => r.json()).then((d) => (data = d)));
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    const MAX = 400;
    const render = () => {
      const r = $('e-role').value, inn = $('e-in').value, q = $('e-q').value.trim().toLowerCase();
      const u = new URLSearchParams(); if (r) u.set('role', r); if (inn) u.set('in', inn); if (q) u.set('q', q);
      history.replaceState(null, '', `${location.pathname}${u.toString() ? '?' + u : ''}`);
      if (!r && !inn && !q) { tbody.innerHTML = initial; $('e-count').textContent = initialCount; return; }
      if (!data) { $('e-count').textContent = 'Loading the full index…'; load().then(render, () => { $('e-count').textContent = 'The full index could not be loaded. Use the letters above.'; }); return; }
      const hits = data.rows.filter(([title, , meta, kinds, , where]) => (!r || kinds.includes(r)) && (!inn || where.includes(inn)) && (!q || `${title} ${meta}`.toLowerCase().includes(q)));
      tbody.innerHTML = hits.slice(0, MAX).map(([title, href, meta, kinds, n, where, off]) =>
        `<tr><td><a href="${esc(href)}">${esc(title)}</a>${off ? '<span class="tag">Official</span>' : ''}${meta ? `<div class="small muted">${esc(meta)}</div>` : ''}</td>` +
        `<td class="small">${kinds.map((k) => esc(data.kinds[k])).join(', ')}</td><td class="small">${n || ''}</td>` +
        `<td class="small">${where.filter((w) => !w.includes('/')).map((w) => `<a href="${esc(data.where[w][1])}">${esc(data.where[w][0])}</a>`).join(' · ')}</td></tr>`).join('');
      $('e-count').textContent = hits.length > MAX ? `First ${MAX} of ${hits.length} matches. Narrow the filters to see the rest.` : `${hits.length} of ${data.rows.length} shown`;
    };
    for (const id of ['e-role', 'e-in']) $(id).addEventListener('change', render);
    let t; $('e-q').addEventListener('input', () => { clearTimeout(t); t = setTimeout(render, 150); });
    if (p.get('role') || p.get('in') || p.get('q')) render();
  })();
</script>
