---
// One sortable, filterable, searchable table of everything in a category (Adam, 2026-11-28): src/lib/group-table.ts.
// The first rows, A to Z, are in the page; the full list loads from /tables/<key>.json the first time a visitor
// searches, filters, sorts or asks for more, so the page stays small. Filters and sort stay in the address (?q=&cat=&sort=...) to share.
import { groupTables } from '../lib/group-table';
interface Props { table: string; heading?: string }
const { table } = Astro.props;
const t = (await groupTables()).get(table)!;
const heading = Astro.props.heading ?? `Every entry in ${t.title}, in one table`;
const FIRST = 100;
const first = t.rows.slice(0, FIRST);
const valCols = t.cols.filter((c) => c.key !== 'year' && !c.num);
const decades = [...new Set(t.rows.map((r) => r.y && `${r.y.slice(0, 3)}0s`).filter(Boolean) as string[])].sort();
const n = t.rows.length.toLocaleString('en-US');
const cfg = { src: t.file, cols: t.cols.map((c) => ({ key: c.key, label: c.label, narrow: !!c.narrow, num: !!c.num })), total: t.rows.length, page: FIRST };
---
<section class="group-table" aria-labelledby="gt-h" data-pagefind-ignore>
  <h2 id="gt-h">{heading}</h2>
  <p class="small muted">{n} {t.noun}, one row each, A to Z (ignoring a leading The, A or An). Search, filter by any column, or sort by a column heading. Each row says why it is here; the page it links to has the sources.</p>
  <form class="lib-filters gt-filters" id="gt-form" onsubmit="return false" aria-label={`Search and filter ${t.title}`}>
    <label class="lt-q">Search <input data-f="q" type="search" placeholder={`Search ${t.noun}`} /></label>
    <button type="button" class="btn gt-toggle" aria-expanded="false" aria-controls="gt-form">Filters</button>
    {valCols.map((c) => <label class="gt-f">{c.label} <select data-f={c.key}><option value="">All</option>{t.options[c.key].map((o) => <option value={o}>{o}</option>)}</select></label>)}
    {decades.length > 1 && <label class="gt-f">Decade <select data-f="decade"><option value="">All</option>{decades.map((d) => <option value={d}>{d}</option>)}</select></label>}
    <label>Sort <select data-sort-select>
      <option value="t-asc">A to Z</option><option value="t-desc">Z to A</option>
      {t.cols.some((c) => c.key === 'year') && <><option value="year-desc">Newest first</option><option value="year-asc">Oldest first</option></>}
      {t.cols.filter((c) => c.num).map((c) => <option value={`${c.key}-desc`}>Most {c.label.toLowerCase()}</option>)}
      {valCols.map((c) => <option value={`${c.key}-asc`}>By {c.label.toLowerCase()}</option>)}
    </select></label>
    <button type="reset" class="btn gt-reset">Clear</button>
    <span class="small muted gt-count" role="status" aria-live="polite">Showing {Math.min(FIRST, t.rows.length).toLocaleString('en-US')} of {n}</span>
  </form>
  <div class="table-wrap">
    <table class="lib gt" id="gt">
      <caption class="visually-hidden">{heading}. Column headings sort the table.</caption>
      <thead><tr>
        <th scope="col" aria-sort="ascending"><button type="button" data-sort="t">Title</button></th>
        {t.cols.map((c) => <th scope="col"><button type="button" data-sort={c.key}>{c.label}</button></th>)}
      </tr></thead>
      <tbody>
        {first.map((r) => (
          <tr>
            <td>{r.h ? <a href={r.h} rel={r.x ? 'noopener' : undefined}>{r.t}</a> : r.t}{r.r && <div class="small muted">{r.r}</div>}</td>
            {t.cols.map((c) => { const x = c.key === 'year' ? r.y : c.num ? r.n?.toLocaleString('en-US') : r.v[c.key]?.join(', '); return <td class={c.narrow ? 'n' : undefined}>{x && <><span class="cell-label">{c.label}: </span>{x}</>}</td>; })}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="gt-more">
    <button type="button" class="btn" data-more hidden={t.rows.length <= FIRST}>Show {FIRST} more</button>
    <button type="button" class="btn" data-all hidden={t.rows.length <= FIRST}>Show all {n}</button>
  </p>
</section>
<script is:inline define:vars={{ cfg }}>
  (() => {
    const form = document.getElementById('gt-form'), table = document.getElementById('gt');
    if (!form || !table) return;
    const tbody = table.tBodies[0], count = form.querySelector('.gt-count');
    const more = document.querySelector('.gt-more [data-more]'), allBtn = document.querySelector('.gt-more [data-all]');
    const f = (k) => form.querySelector(`[data-f="${k}"]`);
    const keys = cfg.cols.filter((c) => c.key !== 'year' && !c.num).map((c) => c.key);
    const fkeys = [...keys, 'decade'].filter((k) => f(k));
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const sk = (s) => String(s).replace(/^["'“‘(\[.…]+/, '').trim().replace(/^(the|a|an)\s+/i, '').toLowerCase().replace(/\d+/g, (m) => m.padStart(6, '0')).replace(/[^a-z0-9 ]/g, '').trim();
    let rows = null, loading = null, limit = cfg.page, sort = 't', dir = 1;
    const p = new URLSearchParams(location.search);
    if (p.get('sort')) { const [k, d] = p.get('sort').split('-'); sort = k; dir = d === 'desc' ? -1 : 1; }
    if (f('q')) f('q').value = p.get('q') || '';
    for (const k of fkeys) if (p.get(k)) f(k).value = p.get(k);
    const load = () => loading ??= fetch(cfg.src).then((r) => r.json()).then((d) => {
      rows = d.rows.map((r) => {
        const v = {}; for (const k of keys) v[k] = (r[k] || []).map((i) => d.options[k][i]);
        return { ...r, v, s: sk(r.t), text: [r.t, r.r || '', r.y || '', ...keys.flatMap((k) => v[k])].join(' ').toLowerCase() };
      });
    });
    const cell = (r, c) => { const x = c.key === 'year' ? r.y : c.num ? (r.n ?? '') === '' ? '' : r.n.toLocaleString('en-US') : r.v[c.key].join(', '); return `<td${c.narrow ? ' class="n"' : ''}>${x ? `<span class="cell-label">${esc(c.label)}: </span>${esc(x)}` : ''}</td>`; };
    const row = (r) => `<tr><td>${r.h ? `<a href="${esc(r.h)}"${r.x ? ' rel="noopener" target="_blank"' : ''}>${esc(r.t)}</a>` : esc(r.t)}${r.r ? `<div class="small muted">${esc(r.r)}</div>` : ''}</td>${cfg.cols.map((c) => cell(r, c)).join('')}</tr>`;
    let timer;
    const render = (push = true) => {
      const q = (f('q')?.value || '').trim().toLowerCase(), want = Object.fromEntries(fkeys.map((k) => [k, f(k).value]));
      const words = q.split(/\s+/).filter(Boolean);
      const hit = rows.filter((r) => words.every((w) => r.text.includes(w)) && keys.every((k) => !want[k] || r.v[k].includes(want[k])) && (!want.decade || (r.y && `${r.y.slice(0, 3)}0s` === want.decade)));
      const numCol = cfg.cols.find((c) => c.key === sort)?.num;
      const val = (r) => sort === 't' ? r.s : sort === 'year' ? (r.y || (dir > 0 ? '9999' : '0000')) : numCol ? String(r.n ?? 0).padStart(6, '0') : (r.v[sort]?.length ? sk(r.v[sort].join(' ')) : (dir > 0 ? '~' : ''));
      hit.sort((a, b) => (val(a) < val(b) ? -1 : val(a) > val(b) ? 1 : 0) * dir || a.s.localeCompare(b.s));
      tbody.innerHTML = hit.slice(0, limit).map(row).join('');
      const shown = Math.min(limit, hit.length), fmt = (x) => x.toLocaleString('en-US');
      clearTimeout(timer);
      timer = setTimeout(() => { count.textContent = hit.length === rows.length ? `Showing ${fmt(shown)} of ${fmt(rows.length)}` : `${fmt(hit.length)} of ${fmt(rows.length)} match${shown < hit.length ? `, showing ${fmt(shown)}` : ''}`; }, 300);
      more.hidden = allBtn.hidden = shown >= hit.length;
      allBtn.textContent = `Show all ${fmt(hit.length)}`;
      const ss = form.querySelector('[data-sort-select]'), sv = `${sort}-${dir > 0 ? 'asc' : 'desc'}`;
      if ([...ss.options].some((o) => o.value === sv)) ss.value = sv;
      for (const th of table.tHead.rows[0].cells) { const k = th.querySelector('button').dataset.sort; if (k === sort) th.setAttribute('aria-sort', dir > 0 ? 'ascending' : 'descending'); else th.removeAttribute('aria-sort'); }
      if (!push) return;
      const u = new URLSearchParams();
      if (q) u.set('q', q);
      for (const k of fkeys) if (want[k]) u.set(k, want[k]);
      if (sort !== 't' || dir < 0) u.set('sort', `${sort}-${dir > 0 ? 'asc' : 'desc'}`);
      history.replaceState(null, '', `${location.pathname}${u.toString() ? '?' + u : ''}${location.hash}`);
    };
    const go = (fn) => () => { load().then(() => { fn?.(); render(); }).catch(() => { count.textContent = 'The full table could not load. The categories above list everything.'; }); };
    form.addEventListener('input', (ev) => { if (!ev.target.matches('select')) go(() => { limit = cfg.page; })(); });
    form.addEventListener('change', (ev) => go(() => { limit = cfg.page; if (ev.target.matches('[data-sort-select]')) { const [k, d] = ev.target.value.split('-'); sort = k; dir = d === 'desc' ? -1 : 1; } })());
    form.addEventListener('reset', () => setTimeout(go(() => { limit = cfg.page; sort = 't'; dir = 1; })));
    form.addEventListener('focusin', () => { load(); }, { once: true });
    const tog = form.querySelector('.gt-toggle');
    tog.addEventListener('click', () => { const on = form.classList.toggle('open'); tog.setAttribute('aria-expanded', String(on)); });
    if (fkeys.some((k) => p.get(k))) { form.classList.add('open'); tog.setAttribute('aria-expanded', 'true'); }
    more.addEventListener('click', go(() => { limit += cfg.page; }));
    allBtn.addEventListener('click', go(() => { limit = Infinity; }));
    for (const b of table.tHead.querySelectorAll('button[data-sort]')) b.addEventListener('click', go(() => { const k = b.dataset.sort; dir = sort === k ? -dir : 1; sort = k; }));
    if ([...p.keys()].some((k) => k === 'q' || k === 'sort' || fkeys.includes(k))) go()();
  })();
</script>
