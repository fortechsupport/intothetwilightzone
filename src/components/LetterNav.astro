---
// A row of A to Z letter links. Letters with no entries are shown but not linked.
interface Props { base: string; letters: string[]; current?: string; label?: string }
const { base, letters, current, label = 'Jump to a letter' } = Astro.props;
const ALL = ['0-9', ...'abcdefghijklmnopqrstuvwxyz'];
---
<nav class="letter-nav" aria-label={label} data-pagefind-ignore>
  <ul>
    {ALL.map((l) => {
      const text = l === '0-9' ? '#' : l.toUpperCase();
      const name = l === '0-9' ? '0 to 9' : l.toUpperCase();
      if (!letters.includes(l)) return <li><span class="off" aria-hidden="true">{text}</span></li>;
      return <li><a href={`${base}${l}/`} aria-label={name} aria-current={l === current ? 'page' : undefined}>{text}</a></li>;
    })}
  </ul>
</nav>
