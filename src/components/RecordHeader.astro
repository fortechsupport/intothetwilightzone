---
// The top of every record page: a type label with context ("Radio drama · Lights Out"), the title,
// and an empty actions bar that the accounts script fills (favorite, watch/read/listen later).
// A credited picture of the record (src/lib/images.ts) sits beside the title; without one, an original
// illustration of its type (RecordArt, decision 0009).
import RecordFigure from './RecordFigure.astro';
import RecordArt from './RecordArt.astro';
import { imagesFor } from '../lib/images';
interface Props { type: string; context?: string; title: string; recKey?: string; contextMeta?: string }
const { type, context, title, recKey, contextMeta } = Astro.props;
const [img, ...more] = imagesFor(recKey);
// A few more pictures under the title; the rest are one click away on the credits page.
const GALLERY = 3;
---
<header class={`record-head${recKey ? ' has-figure' : ''}`}>
  <div class="record-head-text">
  <p class="eyebrow"><span class="eyebrow-in"><span class="eyebrow-type">{type}</span>{context && <span class="eyebrow-ctx" data-pagefind-meta={contextMeta}>{context}</span>}</span></p>
  <h1>{title}</h1>
  <slot />
  {recKey && <div class="record-actions" data-record-key={recKey}></div>}
  {more.length > 0 && (
    <section class="record-gallery" aria-label="More pictures">
      {more.slice(0, GALLERY).map((m) => <RecordFigure img={m} size="thumb" />)}
      {more.length > GALLERY && <p class="small record-gallery-more"><a href={`/credits/images/?for=${encodeURIComponent(recKey!)}`}>All {more.length + 1} pictures</a></p>}
    </section>
  )}
  </div>
  {img ? <RecordFigure img={img} eager /> : recKey && <RecordArt col={recKey.split('/')[0]} type={type} title={title} />}
</header>
