---
// Episode fan tools: the hidden ending and "if you liked this" picks. Where to watch is in the facts list.
import Ending from './Ending.astro';
import SpoilerToggle from './SpoilerToggle.astro';
import { endingOf, relatedEpisodes } from '../../lib/fan';
import { episodeNumber, type Episode } from '../../lib/data';
interface Props { e: Episode }
const { e } = Astro.props;
const ending = endingOf(e.id);
const related = await relatedEpisodes(e);
---
{ending && (
  <section class="ending-box">
    <h2>How it ends</h2>
    <Ending text={ending} />
    <SpoilerToggle />
  </section>
)}


{related.length > 0 && (
  <section class="related-eps">
    <h2>If you liked this, try</h2>
    <ul class="plain">
      {related.map((r) => (
        <li data-mark={`episodes/${r.e.id}`}>
          <a href={`/episodes/${r.e.id}/`}>{r.e.data.title}</a>
          <span class="muted small"> ({r.e.data.series}, {episodeNumber(r.e.data)})</span>
          <span class="seen-mark" aria-hidden="true"></span>
          <div class="small muted">{r.why.join('; ').replace(/^./, (c) => c.toUpperCase())}</div>
        </li>
      ))}
    </ul>
  </section>
)}
