---
// Episode of the day and on-this-day anniversaries. Chosen in the browser from today's date, so a
// static site still changes daily. The episode is the same for everyone on a given day.
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<section class={`today${compact ? ' today-compact' : ''}`} data-today data-compact={compact ? '1' : undefined} data-pagefind-ignore>
  <div class="today-eotd">
    <p class="kicker">Episode of the day <span class="today-date"></span></p>
    <div class="eotd-body"><p class="muted">Loading today's episode…</p></div>
  </div>
  <div class="today-otd">
    <p class="kicker">On this day</p>
    <ul class="otd-list plain small"><li class="muted">Loading…</li></ul>
    {compact && <p class="small"><a href="/today/">More on this day, and pick any date</a></p>}
  </div>
</section>
<script>
  type Ep = { id: string; t: string; s: string; n: string; d: string; w: string[]; sy: string };
  type An = { md: string; y: number; k: string; t: string; u: string };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  // A fixed shuffle seeded by the date: every visitor sees the same episode on the same day.
  function dayNumber(d: Date) { return Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 86400000); }
  function pick<T>(list: T[], day: number) { let x = (day * 2654435761) >>> 0; x ^= x >>> 15; return list[x % list.length]; }

  async function render(root: HTMLElement, date: Date) {
    const [eps, ans]: [Ep[], An[]] = await Promise.all([fetch('/fan/episodes.json').then((r) => r.json()), fetch('/fan/anniversaries.json').then((r) => r.json())]);
    const compact = root.dataset.compact === '1';
    const md = `${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    root.querySelector('.today-date')!.textContent = `· ${MONTHS[date.getMonth()]} ${date.getDate()}`;
    const e = pick(eps, dayNumber(date));
    root.querySelector('.eotd-body')!.innerHTML = `<h3><a href="/episodes/${e.id}/">${esc(e.t)}</a></h3><p class="small muted">${e.s} series, ${e.n}${e.d ? ' · first aired ' + e.d.slice(0, 4) : ''} · written by ${esc(e.w.join(', ') || 'unknown')}</p><p>${esc(e.sy)}</p>` +
      `<p data-mark="episodes/${e.id}"><button type="button" class="mini" data-track="watched" data-key="episodes/${e.id}" aria-pressed="false"><span aria-hidden="true" class="tick"></span>Watched</button></p>`;
    const today = ans.filter((a) => a.md === md);
    const shown = compact ? today.slice(0, 6) : today;
    root.querySelector('.otd-list')!.innerHTML = shown.length
      ? shown.map((a) => `<li><span class="tag">${a.y}</span> <a href="${a.u}">${esc(a.t)}</a> <span class="muted">· ${esc(a.k)}</span></li>`).join('') + (compact && today.length > shown.length ? `<li class="muted">and ${today.length - shown.length} more</li>` : '')
      : `<li class="muted">Nothing in our records on ${MONTHS[date.getMonth()]} ${date.getDate()} yet.</li>`;
    document.dispatchEvent(new Event('tz:repaint'));
  }
  document.querySelectorAll<HTMLElement>('[data-today]').forEach((root) => {
    const q = new URLSearchParams(location.search).get('date');
    const m = q && /^(\d{2})-(\d{2})$/.exec(q);
    const date = m ? new Date(new Date().getFullYear(), Number(m[1]) - 1, Number(m[2])) : new Date();
    render(root, date);
    document.addEventListener('tz:date', (ev) => render(root, (ev as CustomEvent).detail));
  });
</script>
