---
import LinkVote from './fan/LinkVote.astro';
// The episode explorer: every episode, segment or sketch of a show as an entry on one page, with its own
// anchor (#<record id>), and filters for season, person, homage type and how sure we are. Used on every
// show page except the four Twilight Zone series, which have a page per episode (decision 0002).
// Without JavaScript the full list shows; the filters only hide entries.
import { personUrl, formatDate, CONNECTION_LABELS, CONNECTION_VERBS, CONFIDENCE_LABELS } from '../lib/data';
import { sortKey } from '../lib/categories';
import type { ExEntry } from '../lib/television';
import ThemeList from './ThemeList.astro';
import { THEMES, topThemes } from '../lib/themes';
import { segmentPodcastCounts } from '../lib/podcast-episodes';

interface Props { entries: ExEntry[]; id?: string; noun?: string; groupLabel?: string }
const { entries, id = 'ex', noun = 'episodes', groupLabel = 'Season' } = Astro.props;
// Podcasts plan, found for later (done 2026-11-24): podcast episodes whose titles name a Night Gallery segment.
const podCount = entries.some((e) => e.segments.length) ? await segmentPodcastCounts() : new Map<string, number>();

const peopleOf = (e: ExEntry) => [...new Set([...e.writers, ...e.directors, ...e.cast, ...e.segments.flatMap((s) => [...s.writers, ...s.directors, ...s.cast, ...s.source_authors])])];
const people = [...new Set(entries.flatMap(peopleOf))].sort((a, b) => sortKey(a).localeCompare(sortKey(b)));
const groups = [...new Set(entries.map((e) => e.group))];
const kinds = [...new Set(entries.flatMap((e) => e.links.map((l) => l.kind)))].sort();
const certs = ['confirmed-by-creator', 'documented', 'fan-noted'].filter((c) => entries.some((e) => e.links.some((l) => l.certainty === c)));
const themeCounts = new Map(topThemes(entries.map((e) => e.themes), 99));
const slug = (g: string) => `${id}-${g.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
{entries.length > 0 && (
<div class="explorer" id={id}>
  {entries.length > 3 && (
    <form class="lib-filters" data-pagefind-ignore onsubmit="return false" aria-label={`Filter ${noun}`}>
      {groups.length > 1 && <label>{groupLabel} <select data-f="group"><option value="">All</option>{groups.map((g) => <option value={g}>{g}</option>)}</select></label>}
      {people.length > 0 && <label>Person <select data-f="person"><option value="">Anyone</option>{people.map((p) => <option value={p}>{p}</option>)}</select></label>}
      {kinds.length > 0 && <label>Type <select data-f="kind"><option value="">Any</option>{kinds.map((k) => <option value={k}>{CONNECTION_LABELS[k] ?? k}</option>)}</select></label>}
      {themeCounts.size > 0 && <label>Theme <select data-f="theme"><option value="">Any</option>{THEMES.filter((t) => themeCounts.has(t.slug)).map((t) => <option value={t.slug}>{t.label} ({themeCounts.get(t.slug)})</option>)}</select></label>}
      {certs.length > 0 && <label>How sure <select data-f="cert"><option value="">Any</option>{certs.map((c) => <option value={c}>{CONFIDENCE_LABELS[c]}</option>)}</select></label>}
      <label class="lt-q">Search <input data-f="q" type="search" placeholder={`Search ${noun}`} /></label>
      <label>Sort <select data-f="order"><option value="air">Air order</option><option value="az">A to Z</option><option value="za">Z to A</option><option value="new">Newest first</option></select></label>
      <span class="small muted ex-count" role="status"></span>
    </form>
  )}
  {groups.length > 1 && <p class="small letters" data-pagefind-ignore>Jump to: {groups.map((g) => <a href={`#${slug(g)}`}>{g}</a>)}</p>}
  {groups.map((g) => (
    <section class="ex-group" id={slug(g)}>
      {groups.length > 1 && <h3>{g}</h3>}
      <ol class="ex-list plain">
        {entries.filter((e) => e.group === g).map((e) => (
          <li class="ex-entry card" id={e.id}
            data-group={e.group}
            data-people={`|${peopleOf(e).join('|')}|`}
            data-kind={`|${e.links.map((l) => l.kind).join('|')}|`}
            data-cert={`|${e.links.map((l) => l.certainty).join('|')}|`}
            data-themes={`|${e.themes.join('|')}|`}
            data-sort={sortKey(e.title)}
            data-air={`${e.group}|${e.date ?? ''}|${e.id}`} data-date={e.date ?? ''}>
            <h4 class="ex-title"><a href={`#${e.id}`} class="ex-anchor">{e.title}</a></h4>
            <p class="small muted">{[e.number, e.kindLabel !== 'Episode' && e.kindLabel, formatDate(e.date)].filter(Boolean).join(' · ')}</p>
            {e.aka.length > 0 && <p class="small muted">Also known as {e.aka.join(', ')}</p>}
            {e.links.length > 0 && (
              <ul class="plain ex-links">
                {e.links.map((l) => (
                  <li>{CONNECTION_VERBS[l.kind] ?? CONNECTION_LABELS[l.kind]} <a href={l.href}>{l.title}</a> <span class={`tag ${l.certainty}`}>{CONFIDENCE_LABELS[l.certainty]}</span> <LinkVote id={l.id} />{l.evidence && <p class="small muted">{l.evidence}</p>}</li>
                ))}
              </ul>
            )}
            {e.themesFrom === 'episodes' && <ThemeList slugs={e.themes} as="line" from={e.links.filter((l) => l.href.startsWith('/episodes/')).length > 1 ? 'the episodes it points to' : 'the episode it points to'} />}
            {e.summary && e.segments.length !== 1 && <p class="small">{e.summary}</p>}
            {(e.writers.length > 0 || e.directors.length > 0) && (
              <p class="small">{e.writers.length > 0 && <>Written by {e.writers.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</>}{e.writers.length > 0 && e.directors.length > 0 && ' · '}{e.directors.length > 0 && <>Directed by {e.directors.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</>}</p>
            )}
            {e.creditNote && <p class="small muted">{e.creditNote}</p>}
            {e.cast.length > 0 && <p class="small">Cast: {e.cast.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</p>}
            {e.segments.length > 0 && (
              <ul class="plain ex-segments">
                {e.segments.map((sg, i) => (
                  <li id={`${e.id}-${i + 1}`}>
                    <strong>{sg.title}</strong>
                    {sg.adapts && <span class="small"> · adapts <a href={sg.adapts.href}>{sg.adapts.title}</a></span>}
                    {sg.summary && <p class="small">{sg.summary}</p>}
                    <ThemeList slugs={sg.themes} as="line" />
                    {sg.source_title && <p class="small">Based on “{sg.source_title}”{sg.source_authors.length > 0 && <> by {sg.source_authors.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</>}</p>}
                    {!sg.source_title && sg.source_authors.length > 0 && <p class="small">From a story by {sg.source_authors.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</p>}
                    {(sg.writers.length > 0 || sg.directors.length > 0) && <p class="small">{sg.writers.length > 0 && <>Written by {sg.writers.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</>}{sg.writers.length > 0 && sg.directors.length > 0 && ' · '}{sg.directors.length > 0 && <>Directed by {sg.directors.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</>}</p>}
                    {sg.cast.length > 0 && <p class="small">Cast: {sg.cast.map((n, i) => <>{i > 0 && ', '}<a href={personUrl(n)}>{n}</a></>)}</p>}
                    {podCount.get(`${e.id}#${sg.title}`) && <p class="small">Podcasts: <a href={`/podcasts/episodes/?ep=${encodeURIComponent(`${e.id}#${sg.title}`)}`}>{podCount.get(`${e.id}#${sg.title}`)} podcast {podCount.get(`${e.id}#${sg.title}`) === 1 ? 'episode' : 'episodes'}</a> <span class="muted">(matched by title)</span></p>}
                  </li>
                ))}
              </ul>
            )}
            {e.media.length > 0 && <p class="small">Media: {e.media.map((m, i) => <>{i > 0 && ' · '}<a href={m.url} rel="noopener">{m.title}</a>{m.creator && <span class="muted"> ({m.creator})</span>}</>)}</p>}
            {e.sources.length > 0 && <details class="small ex-sources" data-pagefind-ignore><summary>Sources{e.verified && <span class="muted"> · last verified {e.verified}</span>}</summary><ul>{e.sources.map((s) => <li>{s.author && <>{s.author}, </>}{s.url ? <a href={s.url} rel="noopener">{s.title}</a> : s.title}{s.publisher && !s.title.includes(s.publisher) && <span class="muted"> ({s.publisher})</span>}{s.note && <span class="muted"> · {s.note}</span>}</li>)}</ul></details>}
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>
)}
<script is:inline define:vars={{ rootId: id }}>
  (() => {
    const root = document.getElementById(rootId);
    const form = root && root.querySelector('form');
    if (!form) return;
    const items = [...root.querySelectorAll('.ex-entry')];
    for (const it of items) it.dataset.text = it.textContent.toLowerCase();
    const f = (k) => form.querySelector(`[data-f="${k}"]`);
    const val = (k) => (f(k) ? f(k).value : '');
    const count = root.querySelector('.ex-count');
    const p = new URLSearchParams(location.search);
    for (const k of ['group', 'person', 'kind', 'theme', 'cert', 'q', 'order']) if (f(k) && p.get(k)) f(k).value = p.get(k);
    const apply = () => {
      const g = val('group'), per = val('person'), kind = val('kind'), th = val('theme'), cert = val('cert'), q = val('q').trim().toLowerCase();
      let n = 0;
      for (const it of items) {
        const ok = (!g || it.dataset.group === g) && (!per || it.dataset.people.includes(`|${per}|`)) && (!kind || it.dataset.kind.includes(`|${kind}|`)) && (!th || it.dataset.themes.includes(`|${th}|`)) && (!cert || it.dataset.cert.includes(`|${cert}|`)) && (!q || it.dataset.text.includes(q));
        it.hidden = !ok; if (ok) n++;
      }
      for (const sec of root.querySelectorAll('.ex-group')) sec.hidden = ![...sec.querySelectorAll('.ex-entry')].some((x) => !x.hidden);
            for (const list of root.querySelectorAll('.ex-list')) {
        const o = val('order');
        const cmp = { air: (a, b) => a.dataset.air.localeCompare(b.dataset.air), az: (a, b) => a.dataset.sort.localeCompare(b.dataset.sort), za: (a, b) => b.dataset.sort.localeCompare(a.dataset.sort), new: (a, b) => b.dataset.date.localeCompare(a.dataset.date) }[o] || ((a, b) => a.dataset.air.localeCompare(b.dataset.air));
        [...list.children].sort(cmp).forEach((x) => list.appendChild(x));
      }
      if (count) count.textContent = n === items.length ? `${n} ${n === 1 ? 'entry' : 'entries'}` : `${n} of ${items.length} shown`;
      const u = new URLSearchParams(location.search);
      for (const k of ['group', 'person', 'kind', 'theme', 'cert', 'q', 'order']) { const v = k === 'q' ? q : val(k); if (v && !(k === 'order' && v === 'air')) u.set(k, v); else u.delete(k); }
      history.replaceState(null, '', `${location.pathname}${u.toString() ? '?' + u : ''}${location.hash}`);
    };
    form.addEventListener('change', apply);
    form.addEventListener('input', apply);
    apply();
    // A link to one entry shows it even when a filter would hide it.
    const showHash = () => { const t = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1))); if (t && t.closest('.ex-entry')) { const e = t.closest('.ex-entry'); if (e.hidden) { form.reset(); apply(); } e.classList.add('hit'); e.scrollIntoView(); } };
    window.addEventListener('hashchange', showHash);
    showHash();
  })();
</script>
