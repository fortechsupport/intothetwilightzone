---
import Base from '../layouts/Base.astro';
import { navModel } from '../lib/nav';
const verbs = await navModel();
// Starting points shown before anything is typed: well-known episodes, people, places and characters.
const TRY = ['Time Enough at Last', 'Rod Serling', 'Night Gallery', 'Talky Tina', 'Willoughby', 'Richard Matheson', 'Nightmare at 20,000 Feet', 'Jordan Peele'];
---
<Base title="Search" noindex>
  <h1>Search</h1>
  <p class="small muted">Narrow results by type, series, decade, writer and theme. To combine actors, directors, seasons and themes on episodes, use the <a href="/finder/">episode finder</a>.</p>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="search"></div>
  <p id="search-status" class="visually-hidden" role="status" data-pagefind-ignore></p>
  <div class="search-start" id="search-start" data-pagefind-ignore>
    <h2>Try a search</h2>
    <ul class="chips">{TRY.map((t) => <li><a href={`/search/?q=${encodeURIComponent(t)}`} data-q={t}>{t}</a></li>)}</ul>
    <h2>Or browse</h2>
    <ul class="chips">{verbs.map((v) => <li><a href={v.href}>{v.title} <span class="n">{v.n.toLocaleString('en-US')}</span></a></li>)}<li><a href="/categories/">Everything A to Z</a></li><li><a href="/media/">Media Library</a></li></ul>
  </div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: true, resetStyles: false });
      const start = document.getElementById('search-start');
      const q = new URLSearchParams(location.search).get('q');
      if (q) { ui.triggerSearch(q); start.hidden = true; }
      else setTimeout(() => document.querySelector('.pagefind-ui__search-input')?.focus(), 50);
      // Hide the starting points while a search is showing, and keep the address in step so results can be shared.
      const follow = () => {
        const v = (document.querySelector('.pagefind-ui__search-input')?.value ?? '').trim();
        start.hidden = v.length > 0;
        const u = new URL(location.href); if (v) u.searchParams.set('q', v); else u.searchParams.delete('q');
        history.replaceState(null, '', u);
      };
      document.addEventListener('input', (e) => { if (e.target.matches?.('.pagefind-ui__search-input')) follow(); });
      // Pagefind's Clear button empties the box without an input event.
      document.addEventListener('click', (e) => { if (e.target.closest?.('.pagefind-ui__search-clear')) setTimeout(follow, 0); });
      // Screen readers hear the result count once typing pauses (Pagefind's own message is not announced).
      const status = document.getElementById('search-status');
      let said = '', t = 0;
      new MutationObserver(() => {
        clearTimeout(t);
        t = setTimeout(() => { const m = document.querySelector('.pagefind-ui__message')?.textContent.trim() ?? ''; if (m && m !== said) { said = m; status.textContent = m; } }, 700);
      }).observe(document.getElementById('search'), { childList: true, subtree: true, characterData: true });
      // On phones Pagefind stacks its five filters above the results, which pushes every result off the first
      // screen. There they fold behind one "Filters" button (CSS below); beside the results on wider screens they
      // always show and the button is hidden.
      const sbox = document.getElementById('search');
      const toggle = document.createElement('button');
      toggle.type = 'button'; toggle.className = 'btn subtle filters-toggle'; toggle.setAttribute('aria-expanded', 'false');
      toggle.textContent = 'Filters';
      toggle.addEventListener('click', () => {
        const open = !sbox.classList.toggle('filters-closed');
        toggle.setAttribute('aria-expanded', String(open));
        toggle.textContent = open ? 'Hide filters' : 'Filters';
      });
      sbox.classList.add('filters-closed');
      const place = () => { const d = sbox.querySelector('.pagefind-ui__drawer'); if (d && toggle.nextElementSibling !== d) d.before(toggle); };
      new MutationObserver(place).observe(sbox, { childList: true, subtree: true });
      start.addEventListener('click', (e) => {
        const a = e.target.closest('a[data-q]'); if (!a) return;
        e.preventDefault(); ui.triggerSearch(a.dataset.q); start.hidden = true;
        history.replaceState(null, '', a.href);
      });
    });
  </script>
</Base>
<style>
  .search-start { margin-top: var(--space-5); }
  .search-start h2 { font-size: var(--step-1); margin: var(--space-5) 0 var(--space-3); }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 4px 14px; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); text-decoration: none; color: var(--text); }
  .chips a:hover { border-color: var(--brass); color: var(--brass); }
  .chips .n { color: var(--muted); font-size: var(--step--2); }
  :global(.filters-toggle) { display: none; }
  /* Pagefind resets the buttons inside its box, so the button's look is restated here (it matches .btn). */
  :global(#search .filters-toggle) { align-items: center; gap: 8px; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); padding: 8px 18px; min-height: 42px; background: var(--surface); color: var(--text); font: inherit; font-weight: 500; cursor: pointer; }
  :global(#search .filters-toggle:hover) { border-color: var(--brass); }
  :global(#search .filters-toggle:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }
  @media (max-width: 39.99em) {
    :global(.filters-toggle) { display: inline-flex; margin-top: var(--space-3); }
    :global(#search.filters-closed .pagefind-ui__filter-panel) { display: none; }
  }
</style>
