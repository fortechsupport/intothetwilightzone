---
import CategoryLanding from '../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta } from '../lib/landing';
const arch = (await getCollection('archives')).filter((a) => !a.data.duplicate_of);
const items = arch.map((a) => item('archives', a.id, a.data.name, {
  href: a.data.url,
  meta: meta(a.data.institution, a.data.location, a.data.dates && String(a.data.dates)),
  desc: [a.data.description, a.data.extent && `Extent: ${a.data.extent}.`].filter(Boolean).join(' '),
}));
---
<CategoryLanding category="archives" items={items} lead={`${items.length} collections that hold the show's primary sources.`} />
