---
import CategoryLanding from '../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta, year } from '../lib/landing';
import { formatDate } from '../lib/data';
const pods = (await getCollection('podcasts')).filter((p) => !p.data.duplicate_of);
const items = pods.map((p) => item('podcasts', p.id, p.data.title, {
  meta: meta(p.data.hosts.join(', '), p.data.first_episode && `since ${formatDate(p.data.first_episode) ?? year(p.data.first_episode)}`),
  desc: p.data.description, links: p.data.links,
}));
---
<CategoryLanding category="podcasts" items={items} lead={`${items.length} podcasts and podcast episodes about the show.`} />
