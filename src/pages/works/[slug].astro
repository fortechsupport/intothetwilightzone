---
import LinkVote from '../../components/fan/LinkVote.astro';
import ThemeList from '../../components/ThemeList.astro';
import { inheritedThemes } from '../../lib/themes';
import TrackButtons from '../../components/fan/TrackButtons.astro';
import { trackFor } from '../../lib/fan/contribute';
import Base from '../../layouts/Base.astro';
import RecordHeader from '../../components/RecordHeader.astro';
import { recordDocTitle, recordType, recordContext } from '../../lib/titles';
import InCategories from '../../components/InCategories.astro';
import Media from '../../components/Media.astro';
import Related from '../../components/Related.astro';
import Sources from '../../components/Sources.astro';
import ExtLinks from '../../components/ExtLinks.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { resolveRef, CONNECTION_LABELS, CONFIDENCE_LABELS } from '../../lib/data';
import { KIND_LABEL, humanize, detailText } from '../../lib/works';

export async function getStaticPaths() {
  return (await getCollection('works')).filter((w) => !w.data.duplicate_of).map((w) => ({ params: { slug: w.id }, props: { w } }));
}
interface Props { w: CollectionEntry<'works'> }
const { w } = Astro.props;
const d = w.data;
const conns = (await getCollection('connections')).filter((c) => c.data.from === `works/${w.id}`);
const epRefs = conns.map((c) => c.data.to).filter((t) => /^\d{4}\//.test(t));
const themes = await inheritedThemes(epRefs);
const targets = await Promise.all(conns.map(async (c) => ({ c, t: await resolveRef(c.data.to) })));
const details = Object.entries(d.details ?? {}).filter(([, v]) => detailText(v) !== '');
const linkNames: Record<string, string> = { official: 'Official site', home: 'Website' };
const extraLinks = Object.entries(d.links ?? {}).filter(([k]) => k in linkNames);
const otherLinks = Object.fromEntries(Object.entries(d.links ?? {}).filter(([k]) => !(k in linkNames)));
const jsonld = { '@context': 'https://schema.org', '@type': 'CreativeWork', name: d.title, dateCreated: d.year ? String(d.year) : undefined, creator: d.creator, publisher: d.publisher };
---
<Base title={recordDocTitle('works', d, d.title)} description={d.description ?? `${d.title}: ${KIND_LABEL[d.kind] ?? d.kind} connected to The Twilight Zone.`} jsonld={jsonld}>
  <InCategories recKey={`works/${w.id}`} />
  <RecordHeader type={recordType('works', d)} context={recordContext('works', d)} title={d.title} recKey={`works/${w.id}`} />
  {(() => { const t = trackFor('works', (d as any).kind); return (t.seen || t.own) && <TrackButtons recKey={`works/${w.id}`} seen={t.seen} own={t.own} />; })()}
  {d.subtype && <p class="muted">{humanize(d.subtype)}</p>}
  {d.description && <p class="lead">{d.description}</p>}
  <dl class="facts">
    {d.year && <><dt>Year</dt><dd>{d.year}</dd></>}
    {d.creator && <><dt>Creator</dt><dd>{d.creator}</dd></>}
    {d.publisher && <><dt>Publisher or maker</dt><dd>{d.publisher}</dd></>}
    {details.map(([k, v]) => <><dt>{humanize(k)}</dt><dd>{k === 'tracks' && Array.isArray(v) ? <ul class="plain">{v.map((t) => <li>{detailText(t)}</li>)}</ul> : detailText(v)}</dd></>)}
    <ThemeList slugs={themes} from={epRefs.length > 1 ? 'the Twilight Zone episodes it points to' : 'the Twilight Zone episode it points to'} />
  </dl>
  {targets.length > 0 && (
    <section>
      <h2>Twilight Zone connection</h2>
      <ul class="plain">
        {targets.map(({ c, t }) => (
          <li><span class="tag">{CONNECTION_LABELS[c.data.kind]}</span>{t ? <a href={t.url}>{t.title}</a> : c.data.to} <span class={`tag ${c.data.confidence}`}>{CONFIDENCE_LABELS[c.data.confidence]}</span> <LinkVote id={c.id} /></li>
        ))}
      </ul>
    </section>
  )}
  {(extraLinks.length > 0 || Object.keys(otherLinks).length > 0 || d.ids) && (
    <section>
      <h2>Links</h2>
      <p>
        {extraLinks.map(([k, url], i) => <>{i > 0 && ' · '}<a href={url} rel="noopener nofollow">{linkNames[k]}</a></>)}
        {extraLinks.length > 0 && Object.keys(otherLinks).length > 0 && ' · '}
        <ExtLinks ids={d.ids} links={otherLinks} />
      </p>
    </section>
  )}
  <Related recKey={`works/${w.id}`} />
  <Media media={d.media} recKey={`works/${w.id}`} />
  <Sources sources={d.sources} verified={d.last_verified} />
</Base>
