---
import CategoryLanding from '../../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta } from '../../lib/landing';
const works = (await getCollection('works')).filter((w) => !w.data.duplicate_of);
const items = works.map((w) => item('works', w.id, w.data.title, {
  href: `/works/${w.id}/`,
  meta: meta(w.data.subtype?.replace(/-/g, ' '), w.data.year ? String(w.data.year) : undefined, w.data.creator ?? w.data.publisher),
  desc: w.data.description,
}));
---
<CategoryLanding category="works" items={items} lead={`${items.length} games, collectibles, stage shows, attractions, events, honors and resources.`} />
