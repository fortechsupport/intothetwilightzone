---
import CategoryLanding from '../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta } from '../lib/landing';
const mags = (await getCollection('magazines')).filter((m) => !m.data.duplicate_of);
const items = mags.map((m) => item('magazines', m.id, m.data.title, {
  meta: meta(m.data.cover_date && String(m.data.cover_date), m.data.publisher),
  desc: m.data.description, ids: m.data.ids, links: m.data.links,
}));
---
<CategoryLanding category="magazines" items={items} lead={`${items.length} magazine issues: the show's own magazines and other magazines' Twilight Zone coverage.`} />
