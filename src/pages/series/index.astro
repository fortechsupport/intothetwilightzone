---
// Television landing (Watch > Television). The four Twilight Zone series come first, then Night Gallery, then
// the shelves in reading order, and one search box across every show and episode on the site. Most-homaged
// episodes and shows are counted from the connections data. Decision 0002 (Adam, 2026-11-21).
import Base from '../../layouts/Base.astro';
import SectionSummary from '../../components/SectionSummary.astro';
import { getCollection, getEntry } from 'astro:content';
import { catalog } from '../../lib/catalog';
import { allEpisodes, episodeNumber } from '../../lib/data';
import { tv, filmHref, allHomageRows } from '../../lib/television';
import { sortKey } from '../../lib/categories';
import { watchFor, watchShort } from '../../lib/watch';

const c = (await catalog()).get('series')!;
const sub = (slug: string) => c.subs.find((s) => s.slug === slug)!;
const series = (await getCollection('series')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const eps = await allEpisodes();
const epCount = (id: string) => eps.filter((e) => e.data.series === id).length;
const ng = await getEntry('films', 'night-gallery');
const ngEps = (await getCollection('films')).filter((f) => /^night-gallery-s\de\d\d$/.test(f.id));
const ngSegs = ngEps.reduce((t, e) => t + e.data.segments.length, 0);
const conns = await getCollection('connections');
const homageRows = await allHomageRows();
const homageShows = new Set(homageRows.map((r) => r.show)).size;
const allEntries = [...new Map(c.subs.flatMap((s) => s.entries.map((e) => [e.key, e]))).values()];

// Most-homaged Twilight Zone episodes, counting every work that points to them.
const byEp = new Map<string, number>();
for (const x of conns) if (/^\d{4}\//.test(x.data.to)) byEp.set(x.data.to, (byEp.get(x.data.to) ?? 0) + 1);
const epById = new Map(eps.map((e) => [e.id, e]));
const topEps = [...byEp.entries()].filter(([id]) => epById.has(id)).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 10);
const topShows = [...tv.shows.values()].filter((s) => s.slug !== 'night-gallery' && s.entries.length > 1).sort((a, b) => b.entries.length - a.entries.length || sortKey(a.title).localeCompare(sortKey(b.title))).slice(0, 10);

// The search index: every show page and every episode or entry, compact.
type Row = [string, string, string]; // title, context, href
const rows: Row[] = [
  ...series.map((s) => [`${s.data.title} (${s.data.years})`, 'Series', `/series/${s.id}/`] as Row),
  ...eps.map((e) => [e.data.title, `${e.data.series} · ${episodeNumber(e.data)}`, `/episodes/${e.id}/`] as Row),
  ...[...tv.shows.values()].map((s) => [s.title, 'Show', s.href] as Row),
  ...[...tv.shows.values()].flatMap((s) => s.entries.map((id) => [allEntries.find((e) => e.key === `films/${id}`)?.title ?? id, s.title, filmHref(id)] as Row)),
  ...sub('anthologies').entries.concat(sub('pilots-unmade').entries).filter((e) => e.href).map((e) => [e.title, e.group ?? 'Series', e.href!] as Row),
];
const index = [...new Map(rows.map((r) => [r[2], r])).values()];
const order = ['twilight-zone', 'episodes', 'serling-series', 'anthologies', 'homages', 'pilots-unmade', 'international', 'where-to-watch'];
const shelves = order.map((slug) => c.subs.find((s) => s.slug === slug)).filter((s): s is NonNullable<typeof s> => !!s && s.entries.length > 0 && s.slug !== 'twilight-zone');
const more: Record<string, [string, string]> = { homages: ['All homages', '/television/homages/'], 'serling-series': ['Night Gallery', '/night-gallery/'] };
const LABEL: Record<string, string> = { '1959': 'The original series', '1985': 'The 1985 revival', '2002': 'The 2002 revival', '2019': 'The 2019 revival' };
---
<Base title="Television" description={c.description}>
  <p class="breadcrumb" data-pagefind-ignore><a href="/">Home</a> / <a href="/watch/">Watch</a></p>
  <h1>Television</h1>
  <p class="lead">Four Twilight Zone series and all {eps.length} of their episodes, Rod Serling’s other television, the anthologies in its tradition, and the homages paid to it in {homageShows} other shows.</p>

  <form class="tv-find" role="search" data-pagefind-ignore onsubmit="return false">
    <label for="tv-q" class="visually-hidden">Find a show or episode</label>
    <input id="tv-q" type="search" placeholder="Find a show or episode" autocomplete="off" />
    <ul id="tv-results" class="tv-results plain" hidden></ul>
  </form>

  <h2>The Twilight Zone</h2>
  <div class="grid tv-series">
    {series.map((s) => (
      <a class="card" href={`/series/${s.id}/`}>
        <span class="count">{s.id}</span>
        <h3>{LABEL[s.id] ?? s.data.title}</h3>
        <p class="small muted">{s.data.years}</p>
        <p>{s.data.network} · {s.data.seasons} {s.data.seasons === 1 ? 'season' : 'seasons'} · {epCount(s.id)} episodes</p>
        <p class="small">Hosted by {s.data.host}</p>
        {watchShort(watchFor({ series: s.id }).w) && <p class="small watch-inline">{watchShort(watchFor({ series: s.id }).w)}</p>}
      </a>
    ))}
  </div>

  {ng && (
    <a class="card tv-feature" href="/night-gallery/">
      <h3>Rod Serling’s Night Gallery <span class="muted">(1969–1973)</span></h3>
      <p>NBC · 3 seasons · {ngEps.length} episodes and {ngSegs} segments, plus the 1969 pilot film. Serling hosted every story from a gallery of paintings.</p>
      {watchShort(watchFor({ show: 'Night Gallery' }).w) && <p class="small watch-inline">{watchShort(watchFor({ show: 'Night Gallery' }).w)}</p>}
    </a>
  )}

  <h2>Browse</h2>
  <div class="grid">
    {shelves.map((s) => (
      <a class="card" href={`/series/${s.slug}/`}>
        <span class="count">{s.entries.length.toLocaleString('en-US')}</span>
        <h3>{s.title} {s.isNew && <span class="tag new">new</span>}</h3>
        <p>{s.blurb}</p>
      </a>
    ))}
  </div>
  <p class="small">{Object.values(more).map(([l, h], i) => <>{i > 0 && ' · '}<a href={h}>{l}</a></>)} · <a href="/rod-serling/">Rod Serling</a> · <a href="/finder/">Episode finder</a></p>

  <div class="two-col">
    <section>
      <h2>Most-homaged episodes</h2>
      <ol class="rank">
        {topEps.map(([id, n]) => { const e = epById.get(id)!; return <li><a href={`/episodes/${id}/`}>{e.data.title}</a> <span class="muted small">{e.data.series}</span> <span class="count-pill">{n}</span></li>; })}
      </ol>
      <p class="small muted">Counts every film, show, song, book and game we list that points to the episode.</p>
    </section>
    <section>
      <h2>Shows with the most homages</h2>
      <ol class="rank">
        {topShows.map((s) => { const w = watchShort(watchFor({ slug: s.slug }).w); return <li><a href={s.href}>{s.title}</a> <span class="count-pill">{s.entries.length}</span>{w && <span class="small watch-inline">{w}</span>}</li>; })}
      </ol>
      <p class="small"><a href="/television/homages/">All homages</a></p>
    </section>
  </div>

  <aside class="tz-link">
    <h2>How this connects</h2>
    <p>{c.connection}</p>
  </aside>
  <SectionSummary entries={allEntries} scope="series" label="Television" />

  <script type="application/json" id="tv-index" set:html={JSON.stringify(index)} />
  <script is:inline>
    (() => {
      const q = document.getElementById('tv-q'), out = document.getElementById('tv-results');
      const rows = JSON.parse(document.getElementById('tv-index').textContent);
      const norm = (s) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9 ]/g, '');
      const idx = rows.map((r) => [norm(r[0] + ' ' + r[1]), norm(r[0]), r]);
      const esc = (s) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
      q.addEventListener('input', () => {
        const t = norm(q.value.trim());
        if (t.length < 2) { out.hidden = true; out.innerHTML = ''; return; }
        const words = t.split(' ').filter(Boolean);
        const hits = idx.filter(([all]) => words.every((w) => all.includes(w))).sort((a, b) => (b[1].startsWith(t) - a[1].startsWith(t)) || a[1].localeCompare(b[1])).slice(0, 12);
        out.innerHTML = hits.length ? hits.map(([, , r]) => `<li><a href="${esc(r[2])}">${esc(r[0])}</a> <span class="muted small">${esc(r[1])}</span></li>`).join('') : '<li class="muted">Nothing found. Try the <a href="/search/">site search</a>.</li>';
        out.hidden = false;
      });
    })();
  </script>
</Base>
