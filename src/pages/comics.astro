---
import CategoryLanding from '../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta, year } from '../lib/landing';
const comics = (await getCollection('comics')).filter((c) => !c.data.duplicate_of);
const items = comics.map((c) => item('comics', c.id, c.data.title, {
  meta: meta(c.data.publisher, c.data.cover_date && String(c.data.cover_date), c.data.creators?.join(', ')),
  desc: c.data.description, ids: c.data.ids, links: c.data.links,
}));
---
<CategoryLanding category="comics" items={items} lead={`${items.length} comics from six decades and seven publishers.`} />
