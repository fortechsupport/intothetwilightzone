---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { personUrl, resolveRef, formatDate } from '../lib/data';
import { CATEGORIES } from '../lib/categories';
const info = CATEGORIES.quotes;
import { assess } from '../lib/assessments';
const quotes = (await getCollection('quotes')).sort((a, b) => a.data.person.split(' ').slice(-1)[0].localeCompare(b.data.person.split(' ').slice(-1)[0]) || a.data.person.localeCompare(b.data.person));
const rows = await Promise.all(quotes.map(async (q) => ({ q, eps: (await Promise.all(q.data.episodes.map(resolveRef))).filter(Boolean) })));
---
<Base title="Voices" description="What filmmakers, writers, actors and musicians have said about The Twilight Zone and its influence on them.">
  <h1>Voices</h1>
  <p class="lead">{quotes.length} quotes from {new Set(quotes.map((q) => q.data.person)).size} people on what The Twilight Zone meant to them, sorted by surname, each linked to where it was said.</p>
  {info.intro.map((p) => <p set:html={p} />)}
  <aside class="tz-link"><h2>How this connects to The Twilight Zone</h2><p>{info.connection}</p></aside>
  {rows.map(({ q, eps }) => {
    const d = q.data;
    const src = d.sources[0];
    return (
      <figure class="quote" id={q.id}>
        <blockquote>{d.text}</blockquote>
        <figcaption>
          <a href={personUrl(d.person)}>{d.person}</a>
          {d.date && <span class="muted">, {formatDate(d.date)}</span>}
          {src && <span class="muted small"> · {src.url ? <a href={src.url} rel="noopener">{src.title}</a> : src.title}</span>}
          {assess(`quotes/${q.id}`)?.connection && <div class="small muted">{assess(`quotes/${q.id}`)!.connection.replace(/^A sourced quote from [^.]+\.\s*/, '')}</div>}
          {eps.length > 0 && <div class="small muted">On {eps.map((e, i) => <>{i > 0 && ', '}<a href={e!.url}>{e!.title}</a></>)}</div>}
        </figcaption>
      </figure>
    );
  })}
</Base>
