---
import CategoryLanding from '../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta, year } from '../lib/landing';
const books = (await getCollection('books')).filter((b) => !b.data.duplicate_of);
const items = books.map((b) => item('books', b.id, b.data.title, {
  meta: meta(b.data.authors.join(', '), b.data.publisher, year(b.data.published), ...b.data.tags),
  desc: b.data.description, ids: b.data.ids, links: b.data.links,
}));
---
<CategoryLanding category="books" items={items} lead={`${items.length} books in ${new Set(items.map((i) => i.sub)).size} groups, from Serling's own story collections to the latest scholarship.`} />
