---
// The Media Library overview: every kind of media and content on the site, each with its own page
// (/media/<type>/) listing every item and every page it appears on. Old links still work: ?type=review and
// #<item id> are sent on to the right type page by the script below.
import Base from '../../layouts/Base.astro';
import { mediaLibrary } from '../../lib/catalog';
import { MEDIA_TYPES, mediaTypeHref } from '../../lib/media-types';

const items = await mediaLibrary();
const counts = new Map<string, number>();
for (const i of items) counts.set(i.type, (counts.get(i.type) ?? 0) + 1);
const types = MEDIA_TYPES.filter((t) => counts.get(t.key));
const where = Object.fromEntries(items.map((i) => [i.id, i.type]));
const slugs = Object.fromEntries(MEDIA_TYPES.map((t) => [t.key, t.slug]));
const recent = items.filter((i) => i.date).sort((a, b) => b.date!.localeCompare(a.date!)).slice(0, 12);
---
<Base title="Media Library" description="Every video, recording, image, document, review, interview, quote and advertisement on IntoTheTwilightZone.com, with every page it appears on.">
  <p class="breadcrumb" data-pagefind-ignore><a href="/">Home</a></p>
  <h1>Media Library</h1>
  <p class="lead">{items.length.toLocaleString('en-US')} items of media and content. Each one belongs to the pages it is about and appears there. The library gathers them by kind, so you can browse, sort and filter them and see exactly where each one appears.</p>
  <div class="grid media-type-grid">
    {types.map((t) => (
      <a class="card" href={`/media/${t.slug}/`}>
        <span class="count">{counts.get(t.key)!.toLocaleString('en-US')}</span>
        <h2 class="h3">{t.label}</h2>
        <p>{t.what}</p>
      </a>
    ))}
  </div>
  <div class="section-head">
    <h2>Most recent</h2>
    <p>The newest dated items in the library.</p>
  </div>
  <ul class="media-list compact">
    {recent.map((m) => <li><span class="tag">{m.typeLabel}</span> <a href={m.href} rel={m.external ? 'noopener' : undefined}>{m.title}</a> <span class="muted small">{m.date}{m.on[0] && <> · on {m.on[0].href ? <a href={m.on[0].href}>{m.on[0].title}</a> : m.on[0].title}</>}</span></li>)}
  </ul>
  <div class="section-head">
    <h2>Rights</h2>
  </div>
  <p class="small muted">Copyrighted material is linked where the rights holder or an archive hosts it, never copied here. Public-domain items may be kept on this site. <strong>Link only</strong> means we point to it; <strong>Rights holder</strong> means the owner hosts it; <strong>Summary, source linked</strong> means our own page summarizes it and links to the original.</p>
  <script is:inline define:vars={{ where, slugs }}>
    (() => {
      const p = new URLSearchParams(location.search);
      const id = location.hash.slice(1);
      const type = where[id] || p.get('type');
      if (!type || !slugs[type]) return;
      p.delete('type');
      const q = p.toString();
      location.replace(`/media/${slugs[type]}/${q ? '?' + q : ''}${id && where[id] ? '#' + id : ''}`);
    })();
  </script>
</Base>
