---
// A section or category landing page. Sections (People, Places, Organizations) show their kinds and a
// sortable, filterable index of every entry. Categories show their subcategories with counts and
// previews, then the people, places, organizations and media connected to them.
import Base from '../../layouts/Base.astro';
import RecordArt from '../../components/RecordArt.astro';
import { motifForCategory } from '../../lib/motifs';
import EntryList from '../../components/EntryList.astro';
import EntityIndex from '../../components/EntityIndex.astro';
import EntityFinder from '../../components/EntityFinder.astro';
import LetterNav from '../../components/LetterNav.astro';
import SectionSummary from '../../components/SectionSummary.astro';
import { catalog, countOf, entityRows, letterOf, SPLIT_INDEX_AT, type CatInfo } from '../../lib/catalog';
import { verbOf } from '../../lib/taxonomy.mjs';
import ListTools from '../../components/ListTools.astro';
import GroupTable from '../../components/GroupTable.astro';
import { movieFacets } from '../../lib/facets';

export async function getStaticPaths() {
  const cats = await catalog();
  // Television has its own landing page (src/pages/series/index.astro).
  return [...cats.values()].filter((c) => c.slug !== 'series').map((c) => ({ params: { cat: c.slug }, props: { c } }));
}
interface Props { c: CatInfo }
const { c } = Astro.props;
const subs = c.subs.filter((s) => s.entries.length > 0);
const empty = c.subs.filter((s) => s.entries.length === 0);
const total = countOf(c);
const PREVIEW = 8;
const section = c.kind === 'section';
const canSplit = c.split || c.slug === 'organizations';
const offN = (list: { official?: boolean }[]) => list.filter((e) => e.official === true).length;
const allEntries = [...new Map(c.subs.flatMap((s) => s.entries.map((e) => [e.key, e]))).values()];
const totalOff = offN(allEntries);
const group = verbOf(c.slug);
// Discover, View and Listen: one sortable, filterable, searchable table per category (Adam, 2026-11-28), in place of
// the shelf previews and the A to Z indexes. The shelf pages keep the Official and Unofficial shelves.
const table = group && ['discover', 'view', 'listen'].includes(group.slug);
const entRows = section ? await entityRows(c.slug as any) : [];
const split = entRows.length > SPLIT_INDEX_AT;
const letters = [...new Set(entRows.map((r) => letterOf(r.sort)))].sort();
// Movies: one list of every film, A to Z, with filters by shelf, type, decade, episode and confidence
// (plan docs/plans/research-movies.md, section 3), in place of the shelf previews.
const finder = c.slug === 'movies';
const finderEntries = finder ? allEntries.map((e) => ({ ...e, group: undefined, facets: { ...e.facets, shelf: subs.filter((s) => s.entries.some((x) => x.key === e.key)).map((s) => s.title) } })).sort((a, b) => a.sort.localeCompare(b.sort)) : [];
const finderFacets = movieFacets(c.slug, finderEntries);
const NOUN: Record<string, string> = { people: 'people', places: 'places', organizations: 'organizations' };
// Places (Adam, 2026-11-26: Visit folded into Discover "with tabs to toggle between Real Places and Settings"):
// one tab for the real places and their kinds, one for the fictional settings of the stories.
const placeTabs = c.slug === 'places';
const SETTINGS = 'in-story';
const settingSub = placeTabs ? c.subs.find((s) => s.slug === SETTINGS) : undefined;
const settings = [...(settingSub?.entries ?? [])].sort((a, b) => a.sort.localeCompare(b.sort));
// People (Adam's menu sheet, 2026-11-27: "Combines Real people, Characters, and Fans (Community forums)"): three tabs,
// with the A to Z of everyone below them.
const peopleTabs = c.slug === 'people';
const TAB_OUT = ['characters', 'fans'];
const charSub = peopleTabs ? c.subs.find((s) => s.slug === 'characters') : undefined;
const fanSub = peopleTabs ? c.subs.find((s) => s.slug === 'fans') : undefined;
const charTop = [...(charSub?.entries ?? [])].sort((a, b) => a.sort.localeCompare(b.sort));
const fans = [...(fanSub?.entries ?? [])].sort((a, b) => a.sort.localeCompare(b.sort));
const cats0 = peopleTabs ? await catalog() : undefined;
const nOf = (cat: string, sub: string) => cats0?.get(cat)?.subs.find((x) => x.slug === sub)?.entries.length ?? 0;
const FAN_LINKS: [string, string, string, number | undefined][] = peopleTabs ? [
  ['Community forums', '/community/forum/', 'Talk about episodes, collecting and research with other fans. Sign in to post.', undefined],
  ['Fan contributions', '/community/uploads/', 'Photos, scans and finds that fans have shared, each credited and checked before it appears.', undefined],
  ['Fan clubs and communities', '/organizations/fan-groups/', 'Fan clubs, forums, wikis and other communities devoted to the show.', nOf('organizations', 'fan-groups')],
  ['Fan-made work', '/homages/fan-made/', 'Fan films, edits, audio dramas and games, credited to their makers and linked.', nOf('homages', 'fan-made')],
] : [];
const tabbed = placeTabs || peopleTabs;
const realSubs = placeTabs ? subs.filter((s) => s.slug !== SETTINGS) : peopleTabs ? subs.filter((s) => !TAB_OUT.includes(s.slug)) : subs;
const realRows = placeTabs ? entRows.filter((r) => r.subs.some((s) => s.slug !== SETTINGS)) : entRows;
const realPeople = peopleTabs ? entRows.filter((r) => r.subs.some((s) => !TAB_OUT.includes(s.slug))).length : 0;
const firstTab = placeTabs ? 'real-places' : 'real-people';
---
<Base title={c.title} description={c.description}>
  <div class="page-head has-art">
  <div>
  <p class="breadcrumb" data-pagefind-ignore><a href="/">Home</a>{group && <> / <a href={group.href}>{group.title}</a></>}</p>
  <h1>{c.title} {c.isNew && <span class="tag new" title="Added during research; Adam decides whether to keep it">new</span>}</h1>
  <p class="lead">{total.toLocaleString('en-US')} {total === 1 ? 'entry' : 'entries'}{section ? `, in ${subs.length} kinds` : ` in ${subs.length} ${subs.length === 1 ? 'subcategory' : 'subcategories'}`}{canSplit && totalOff > 0 && totalOff < total && `, ${totalOff.toLocaleString('en-US')} official and ${(total - totalOff).toLocaleString('en-US')} unofficial or inspired`}.</p>
  </div>
  <RecordArt title={c.title} motif={motifForCategory(c.slug)} />
  </div>
  {split && <LetterNav base={`/${c.slug}/a-z/`} letters={letters} label={`Browse ${c.title.toLowerCase()} A to Z`} />}
  {c.intro.map((p) => <p set:html={p} />)}
  <aside class="tz-link">
    <h2>How this connects to The Twilight Zone</h2>
    <p>{c.connection}</p>
  </aside>
  {c.seeAlso && <p class="small">See also: {c.seeAlso.map(([l, h], i) => <>{i > 0 && ' · '}<a href={h}>{l}</a></>)}</p>}
  {placeTabs && (
    <div class="tabs" role="tablist" aria-label="Real places or settings" data-tabs hidden>
      <button type="button" role="tab" id="tab-real-places" aria-controls="real-places" aria-selected="true">Real places <span class="count-pill">{realRows.length}</span></button>
      <button type="button" role="tab" id="tab-settings" aria-controls="settings" aria-selected="false" tabindex="-1">Settings <span class="count-pill">{settings.length}</span></button>
    </div>
  )}
  {peopleTabs && (
    <div class="tabs" role="tablist" aria-label="Real people, characters or fans" data-tabs hidden>
      <button type="button" role="tab" id="tab-real-people" aria-controls="real-people" aria-selected="true">Real people <span class="count-pill">{realPeople.toLocaleString('en-US')}</span></button>
      <button type="button" role="tab" id="tab-characters" aria-controls="characters" aria-selected="false" tabindex="-1">Characters <span class="count-pill">{charTop.length.toLocaleString('en-US')}</span></button>
      <button type="button" role="tab" id="tab-fans" aria-controls="fans" aria-selected="false" tabindex="-1">Fans <span class="count-pill">{fans.length}</span></button>
    </div>
  )}
  {tabbed && <script is:inline define:vars={{ ids: placeTabs ? ['real-places', 'settings'] : ['real-people', 'characters', 'fans'] }}>
    // Before the panels are drawn: show the tabs and pick the panel the address asks for, so nothing shifts.
    document.querySelector('[data-tabs]').hidden = false;
    document.documentElement.dataset.catTab = ids.includes(location.hash.slice(1)) ? location.hash.slice(1) : ids[0];
  </script>}
  <div id={tabbed ? firstTab : undefined} role={tabbed ? 'tabpanel' : undefined} aria-labelledby={tabbed ? `tab-${firstTab}` : undefined}>
  <h2>{placeTabs ? 'Kinds of real places' : peopleTabs ? 'Kinds of real people' : section ? 'Kinds' : 'Subcategories'}</h2>
  <div class="grid">
    {realSubs.map((s) => (
      <a class="card" href={`/${c.slug}/${s.slug}/`}>
        <span class="count">{s.entries.length.toLocaleString('en-US')}</span>
        <h3>{s.title} {s.isNew && <span class="tag new">new</span>}</h3>
        <p>{s.blurb}</p>
        {canSplit && s.side !== 'neither' && (() => { const o = offN(s.entries); const u = s.entries.length - o; return <p class="small muted">{o > 0 && u > 0 ? `${o} official · ${u} unofficial` : o > 0 ? 'All official' : 'Unofficial and inspired'}</p>; })()}
      </a>
    ))}
  </div>
  {empty.length > 0 && <p class="small muted">Planned, with no entries yet: {empty.map((s, i) => <>{i > 0 && ', '}{s.title}{s.isNew && ' (new)'}</>)}. Research is under way.</p>}
  {peopleTabs || (table && section) ? null : table ? (
    <>
      <GroupTable table={c.slug} />
      <SectionSummary entries={allEntries} scope={c.slug} label={c.title} />
    </>
  ) : section ? (
    <>
      <h2>Every {placeTabs ? 'real place' : peopleTabs ? 'person and character' : c.title.toLowerCase().replace(/s$/, '')} A to Z</h2>
      {split ? (
        <>
          <p class="small muted">{entRows.length.toLocaleString('en-US')} entries, one page per letter{c.slug === 'people' && ', filed by surname'} (the letters at the top of this page). Or filter and search them all here.</p>
          <EntityFinder section={c.slug as any} noun={NOUN[c.slug]} />
        </>
      ) : (
        <>
          <p class="small muted">Sort by name or number of records, filter by kind or by where they appear, or search. Each name links to its page, which links back to every record.</p>
          <EntityIndex section={c.slug as any} noun={NOUN[c.slug]} rows={realRows} />
        </>
      )}
    </>
  ) : (
    <>
      <SectionSummary entries={allEntries} scope={c.slug} label={c.title} />
      {finder ? (
        <section>
          <h2>Every film A to Z</h2>
          <p class="small muted">Filter by section, type, decade, the Twilight Zone episode a film points to, or how sure the link is, or search. Titles are alphabetical, ignoring a leading "The", "A" or "An".</p>
          <ListTools scope="finder" noun="films" sides={canSplit} tiers={new Set(finderEntries.map((e) => e.tier ?? 'core')).size > 1} facets={finderFacets} />
          <div id="finder"><EntryList entries={finderEntries} facets={finderFacets.map((f) => f.key)} /></div>
        </section>
      ) : subs.map((s) => (
        <section id={s.slug}>
          <h2><a href={`/${c.slug}/${s.slug}/`}>{s.title}</a> <span class="muted small">({s.entries.length.toLocaleString('en-US')})</span></h2>
          {s.intro && <p>{s.intro}</p>}
          <EntryList entries={s.entries.slice(0, PREVIEW)} />
          {s.entries.length > PREVIEW && <p><a href={`/${c.slug}/${s.slug}/`}>See all {s.entries.length.toLocaleString("en-US")}</a></p>}
        </section>
      ))}
    </>
  )}
  </div>
  {peopleTabs && (
    <>
      <div id="characters" role="tabpanel" aria-labelledby="tab-characters">
        <h2>Characters</h2>
        {charSub?.intro && <p>{charSub.intro}</p>}
        <p class="small muted">{charTop.length.toLocaleString('en-US')} characters from the episodes, films, radio dramas and comics, grouped by kind on <a href="/people/characters/">their own page</a>. The first {PREVIEW * 3} A to Z:</p>
        <EntryList entries={charTop.slice(0, PREVIEW * 3)} />
        <p><a href="/people/characters/">All {charTop.length.toLocaleString('en-US')} characters</a></p>
      </div>
      <div id="fans" role="tabpanel" aria-labelledby="tab-fans">
        <h2>Fans</h2>
        <div class="grid">
          {FAN_LINKS.map(([t, h, b, n]) => (
            <a class="card" href={h}>
              <span class="count">{n === undefined ? 'Join in' : n.toLocaleString('en-US')}</span>
              <h3>{t}</h3>
              <p>{b}</p>
            </a>
          ))}
        </div>
        <h3>{fanSub?.title}</h3>
        {fanSub?.intro && <p>{fanSub.intro}</p>}
        <EntryList entries={fans} />
      </div>
    </>
  )}
  {peopleTabs && (
    <>
      <GroupTable table="people" heading="Everyone A to Z: real people, characters and fans, in one table" />
      <p class="small muted">Or browse one page per letter, filed by surname (the letters at the top of this page).</p>
    </>
  )}
  {placeTabs && (
    <div id="settings" role="tabpanel" aria-labelledby="tab-settings">
      <h2>Settings in the stories</h2>
      {settingSub?.blurb && <p>{settingSub.blurb}</p>}
      <p class="small muted">{settings.length} fictional places, A to Z. Each links to its page, which names the episodes and stories set there. <a href={`/places/${SETTINGS}/`}>Settings on a page of their own</a>.</p>
      <EntryList entries={settings} />
    </div>
  )}
  {table && section && !peopleTabs && <GroupTable table={c.slug} heading={placeTabs ? 'Every place A to Z, real places and settings, in one table' : undefined} />}
  <script>
    // Tabs for Places (Real places, Settings) and People (Real people, Characters, Fans) (WAI-ARIA tabs pattern). Without JavaScript both panels show in turn.
    const list = document.querySelector<HTMLElement>('[data-tabs]');
    if (list) {
      const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const show = (id: string, focus = false) => {
        document.documentElement.dataset.catTab = id;
        for (const t of tabs) {
          const on = t.getAttribute('aria-controls') === id;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
        }
      };
      const ids = tabs.map((t) => t.getAttribute('aria-controls')!);
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => { show(ids[i]); history.replaceState(null, '', `#${ids[i]}`); });
        t.addEventListener('keydown', (e) => {
          const j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? ids.length - 1 : null;
          if (j === null) return;
          e.preventDefault();
          show(ids[(j + ids.length) % ids.length], true);
        });
      });
      const pick = () => show(ids.includes(location.hash.slice(1)) ? location.hash.slice(1) : ids[0]);
      pick();
      addEventListener('hashchange', pick);
    }
  </script>
</Base>
