---
// One letter of a large section's A to Z index (People has thousands of entries, too many for one page).
import Base from '../../../layouts/Base.astro';
import EntityIndex from '../../../components/EntityIndex.astro';
import LetterNav from '../../../components/LetterNav.astro';
import { catalog, entityRows, letterOf, SPLIT_INDEX_AT } from '../../../lib/catalog';

export async function getStaticPaths() {
  const out = [];
  for (const c of (await catalog()).values()) {
    if (c.kind !== 'section') continue;
    const rows = await entityRows(c.slug as any);
    if (rows.length <= SPLIT_INDEX_AT) continue;
    const letters = [...new Set(rows.map((r) => letterOf(r.sort)))].sort();
    for (const l of letters) out.push({ params: { cat: c.slug, letter: l }, props: { title: c.title, letters, rows: rows.filter((r) => letterOf(r.sort) === l) } });
  }
  return out;
}
const { cat, letter } = Astro.params;
const { title, letters, rows } = Astro.props as { title: string; letters: string[]; rows: Awaited<ReturnType<typeof entityRows>> };
const L = letter === '0-9' ? '0 to 9' : letter!.toUpperCase();
const noun = title.toLowerCase();
const i = letters.indexOf(letter!);
const label = (l: string) => (l === '0-9' ? '0 to 9' : l.toUpperCase());
---
<Base title={`${title}: ${L}`} description={`${title} on IntoTheTwilightZone.com filed under ${L}: ${rows.length} entries, each with the records they appear in.`}>
  <p class="breadcrumb" data-pagefind-ignore><a href="/">Home</a> / <a href={`/${cat}/`}>{title}</a></p>
  <h1>{title}: {L}</h1>
  <p class="lead">{rows.length.toLocaleString('en-US')} {rows.length === 1 ? 'entry' : 'entries'}{cat === 'people' && ', filed by surname'}. Sort by name or number of records, or filter by kind and where they appear.</p>
  <LetterNav base={`/${cat}/a-z/`} letters={letters} current={letter} />
  <EntityIndex section={cat as any} noun={noun} rows={rows} />
  <nav class="pager" aria-label="Letters" data-pagefind-ignore>
    {i > 0 && <a href={`/${cat}/a-z/${letters[i - 1]}/`} rel="prev">← {label(letters[i - 1])}</a>}
    {i < letters.length - 1 && <a href={`/${cat}/a-z/${letters[i + 1]}/`} rel="next">{label(letters[i + 1])} →</a>}
  </nav>
</Base>
