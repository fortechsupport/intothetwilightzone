---
// A subcategory landing page: intro, connection, then every entry A-Z. In categories that split, the list
// comes in two parts, Official and Unofficial and inspired; within each, groups with counts and a letter index.
import Base from '../../layouts/Base.astro';
import RecordArt from '../../components/RecordArt.astro';
import { motifForCategory } from '../../lib/motifs';
import EntryList from '../../components/EntryList.astro';
import SectionSummary from '../../components/SectionSummary.astro';
import ListTools from '../../components/ListTools.astro';
import GroupTable from '../../components/GroupTable.astro';
import { catalog, type CatInfo, type SubInfo, type Entry } from '../../lib/catalog';
import { sortKey, OFFICIAL_LABEL, UNOFFICIAL_LABEL, verbOf, READ_ORDER } from '../../lib/taxonomy.mjs';
import { watchFor, watchShort } from '../../lib/watch';
import { movieFacets } from '../../lib/facets';

export async function getStaticPaths() {
  const cats = await catalog();
  // An empty shelf gets no page (the category page already hides it), so no visitor lands on an empty list, unless
  // Adam asked for it by name (keepEmpty: Card games, menu sheet 2026-11-27), where the page says what was searched.
  // Pages with their own design at a shelf's address: /series/twilight-zone/ (src/pages/series/twilight-zone.astro).
  const OWN = new Set(['series/twilight-zone']);
  return [...cats.values()].flatMap((c) => c.subs.filter((s) => (s.entries.length > 0 || s.keepEmpty) && !OWN.has(`${c.slug}/${s.slug}`)).map((s) => ({ params: { cat: c.slug, sub: s.slug }, props: { c, s } })));
}
interface Props { c: CatInfo; s: SubInfo }
const { c, s } = Astro.props;
const chrono = s.order === 'chrono';
const SERIES_FIRST = /^The Twilight Zone/;
// A shelf may fix its group order (Music: the order the shows were made in); otherwise groups are A to Z.
const fixed = (g: string) => s.groups?.indexOf(g) ?? -1;
const rank = (g: string) => (fixed(g) >= 0 ? `0${String(fixed(g)).padStart(3, '0')}` : g === '' ? 'zz' : /^other\b/i.test(g) || /not yet confirmed|fellow anthology/i.test(g) ? `y${sortKey(g)}` : SERIES_FIRST.test(g) ? `a${g}` : `m${sortKey(g)}`);
const groupsOf = (list: Entry[]) => {
  const groups = new Map<string, Entry[]>();
  for (const e of list) {
    const g = e.group ?? '';
    if (!groups.has(g)) groups.set(g, []);
    groups.get(g)!.push(e);
  }
  const ordered = [...groups.entries()].sort((a, b) => rank(a[0]).localeCompare(rank(b[0]), undefined, { numeric: true }));
  if (ordered.length > 1 && ordered.some(([g]) => g === '')) ordered.find(([g]) => g === '')![0] = 'Other';
  return ordered;
};
const byLetter = (list: Entry[]) => {
  const m = new Map<string, Entry[]>();
  for (const e of list) {
    const L = (e.sort[0] ?? '#').toUpperCase().replace(/[^A-Z]/, '#');
    if (!m.has(L)) m.set(L, []);
    m.get(L)!.push(e);
  }
  return [...m.entries()].sort((a, b) => a[0].localeCompare(b[0]));
};
// A shelf marked side 'neither' (Read: the stories behind the episodes) shows no official split.
const canSplit = (c.split || c.slug === 'organizations') && s.side !== 'neither';
const off = s.entries.filter((e) => e.official === true);
const unoff = s.entries.filter((e) => e.official !== true);
const split = canSplit && off.length > 0 && unoff.length > 0;
const parts: { id: string; label: string; entries: Entry[] }[] = split
  ? [{ id: 'official', label: s.splitLabels?.[0] ?? OFFICIAL_LABEL, entries: off }, { id: 'unofficial', label: s.splitLabels?.[1] ?? UNOFFICIAL_LABEL, entries: unoff }]
  : [{ id: '', label: '', entries: s.entries }];
const sideNote = canSplit && !split && s.entries.length ? (off.length ? `Everything here is official.` : `Everything here is unofficial or inspired by the show.`) : '';
const showWatch = c.slug === 'series' && s.slug === 'homages';
const compact = c.slug === 'people' || (s.entries.length > 400 && !s.entries.some((e) => e.desc));
const gid = (p: string, g: string) => `${p ? p + '-' : ''}${g.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const siblings = c.subs.filter((x) => x.entries.length > 0);
// Movies: filters by type, decade, the Twilight Zone episode a film points to, and how sure the link is.
const facetDefs = movieFacets(c.slug, s.entries);
// Read's seven formats are its categories (Adam, 2026-11-28): each is one sortable, filterable, searchable table.
const asTable = c.slug === 'reading' && READ_ORDER.includes(s.slug);
const totalGroups = asTable ? 0 : parts.reduce((n, p) => n + groupsOf(p.entries).length, 0);
---
<Base title={`${s.title}: ${c.title}`} description={`${s.title} (${c.title}): ${s.blurb}`}>
  <div class="page-head has-art">
  <div>
  <p class="breadcrumb" data-pagefind-ignore><a href="/">Home</a>{(() => { const g = verbOf(c.slug); return g ? <> / <a href={g.href}>{g.title}</a></> : null; })()} / <a href={`/${c.slug}/`}>{c.title}</a></p>
  <h1>{s.title} {(s.isNew || c.isNew) && <span class="tag new" title="Added during research; Adam decides whether to keep it">new</span>}</h1>
  <p class="lead">{s.entries.length.toLocaleString('en-US')} {s.entries.length === 1 ? 'entry' : 'entries'}{split && `: ${off.length.toLocaleString('en-US')} official, ${unoff.length.toLocaleString('en-US')} unofficial and inspired`}. {s.blurb}</p>
  </div>
  <RecordArt title={s.title} motif={motifForCategory(c.slug)} />
  </div>
  {s.intro && <p>{s.intro}</p>}
  <aside class="tz-link">
    <h2>How this connects to The Twilight Zone</h2>
    <p>{s.connection ?? c.connection}</p>
    {sideNote && <p class="small">{sideNote}</p>}
  </aside>
  {(split || totalGroups > 1) && (
    <nav class="subnav" aria-label="Sections" data-pagefind-ignore>
      <h2>In this section</h2>
      {parts.map((p) => {
        const gs = groupsOf(p.entries);
        return (
          <>
            {p.label && <h3><a href={`#${p.id}`}>{p.label}</a> <span class="count-pill">{p.entries.length}</span></h3>}
            {gs.length > 1 && <ul>{gs.map(([g, list]) => <li><a href={`#${gid(p.id, g)}`}>{g}</a> <span class="count-pill">{list.length}</span></li>)}</ul>}
          </>
        );
      })}
      <p class="small muted">{split && 'Official items were made, broadcast, licensed or published by the franchise or by Rod Serling; the rest were made by others about, after or inspired by the show. '}{chrono ? (s.orderNote ?? 'Seasons and episodes are in series order.') : <>{s.groups ? 'Groups are in the order shown, with catch-all groups last.' : 'Groups are alphabetical, with catch-all and unconfirmed groups last.'} Entries are alphabetical, ignoring a leading "The", "A" or "An".</>}</p>
    </nav>
  )}
  {!s.entries.length && <p class="muted">No entries yet. <a href="/contribute/">Suggest one</a>.</p>}
  {asTable && <GroupTable table={`reading/${s.slug}`} />}
  {!asTable && s.entries.length > 5 && (
    <ListTools scope="list" noun={s.title.toLowerCase()} groups={[...new Set(s.entries.map((e) => e.group).filter(Boolean) as string[])].sort((a, b) => rank(a).localeCompare(rank(b), undefined, { numeric: true }))} sides={split} tiers={new Set(s.entries.map((e) => e.tier ?? 'core')).size > 1} years={s.entries.some((e) => /\b(1[89]\d\d|20\d\d)\b/.test(e.meta ?? ''))} groupLabel={c.slug === 'series' && s.slug === 'homages' ? 'Show' : s.slug === 'rod-serling-films' ? "Serling's part" : s.groups?.some((g) => /Twilight Zone|Night Gallery/.test(g)) ? 'Show or film' : 'Group'} facets={facetDefs} orderLabels={chrono ? [s.orderNote ? 'Date order' : 'Series order', 'Reverse order'] : undefined} />
  )}
  <div id="list">
  {!asTable && parts.map((p) => {
    const gs = groupsOf(p.entries);
    const multi = gs.length > 1;
    const letters = !multi && !chrono && p.entries.length > 40;
    const H = p.label ? 'h3' : 'h2';
    return (
      <section id={p.id || undefined} class={p.id ? `side side-${p.id}` : undefined}>
        {p.label && <h2 class="side-head">{p.label} <span class="muted small">({p.entries.length.toLocaleString('en-US')})</span></h2>}
        {letters && <p class="letters" data-pagefind-ignore>{byLetter(p.entries).map(([L]) => <a href={`#${gid(p.id, 'letter-' + L)}`}>{L}</a>)}</p>}
        {multi ? gs.map(([g, list]) => (
          <section id={gid(p.id, g)}>
            <H>{g} <span class="muted small">({list.length})</span>{showWatch && (() => { const w = watchShort(watchFor({ show: g }).w); return w && <span class="small watch-inline">{w}</span>; })()}</H>
            <EntryList entries={list} compact={compact} facets={facetDefs.map((f) => f.key)} />
          </section>
        )) : letters ? byLetter(p.entries).map(([L, list]) => (
          <section id={gid(p.id, 'letter-' + L)}>
            <H>{L}</H>
            <EntryList entries={list} compact={compact} facets={facetDefs.map((f) => f.key)} />
          </section>
        )) : <EntryList entries={p.entries} compact={compact} facets={facetDefs.map((f) => f.key)} />}
      </section>
    );
  })}
  </div>
  {c.kind !== 'section' && <SectionSummary entries={s.entries} scope={`${c.slug}/${s.slug}`} label={s.title} />}
  {c.kind === 'section' && <p class="small"><a href={`/${c.slug}/?role=${s.slug}`}>Browse all {c.title.toLowerCase()}</a></p>}
  <nav class="subnav siblings" aria-label={`More in ${c.title}`} data-pagefind-ignore>
    <h2>More in {c.title}</h2>
    <ul>{siblings.map((x) => <li>{x.slug === s.slug ? <strong>{x.title}</strong> : <a href={`/${c.slug}/${x.slug}/`}>{x.title}</a>} <span class="count-pill">{x.entries.length}</span></li>)}</ul>
  </nav>
</Base>
