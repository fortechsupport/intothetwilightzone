---
import CategoryLanding from '../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta } from '../lib/landing';
import { allEpisodes } from '../lib/data';
const radio = (await getCollection('radio')).filter((r) => !r.data.duplicate_of);
const eps = new Map((await allEpisodes()).map((e) => [e.id, e]));
const items = radio.map((r) => {
  const ep = r.data.adapts_episode ? eps.get(r.data.adapts_episode) : undefined;
  return item('radio', r.id, r.data.title, {
    href: ep ? `/episodes/${ep.id}/` : undefined,
    meta: meta(r.data.voiced_by.length ? `with ${r.data.voiced_by.join(', ')}` : undefined, r.data.adapted_by && `adapted by ${r.data.adapted_by}`, r.data.volume && `volume ${r.data.volume}`),
    desc: r.data.description, ids: r.data.ids,
  });
});
---
<CategoryLanding category="radio" items={items} lead={`${items.length} radio dramas and broadcasts. Titles link to the television episode each one adapts.`} />
