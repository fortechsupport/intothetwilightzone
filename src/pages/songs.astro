---
import CategoryLanding from '../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta } from '../lib/landing';
import { sortKey } from '../lib/categories';
const songs = (await getCollection('songs')).filter((s) => !s.data.duplicate_of);
// Listed as "Title, by Artist", alphabetical by song title.
const items = songs.map((s) => item('songs', s.id, s.data.artist ? `${s.data.title}, by ${s.data.artist}` : s.data.title, {
  sort: sortKey(`${s.data.title} ${s.data.artist ?? ''}`),
  meta: meta(s.data.album, s.data.year ? String(s.data.year) : undefined, s.data.genre),
  desc: [s.data.description, s.data.lyric_excerpt && `"${s.data.lyric_excerpt}"`].filter(Boolean).join(' '),
  ids: s.data.ids, links: s.data.links,
}));
---
<CategoryLanding category="songs" items={items} lead={`${items.length} pieces of music: the theme, its covers and samples, and songs that name the show.`} />
