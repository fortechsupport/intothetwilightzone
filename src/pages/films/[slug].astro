---
import Base from '../../layouts/Base.astro';
import FilmRecord from '../../components/FilmRecord.astro';
import { recordDocTitle } from '../../lib/titles';
import { getCollection, type CollectionEntry } from 'astro:content';
import { isEntryOnly } from '../../lib/television';

// Episodes, segments and sketches of a show other than The Twilight Zone have no page of their own:
// they are entries on their show's page (decision 0002). Night Gallery's page is /night-gallery/.
export async function getStaticPaths() {
  return (await getCollection('films'))
    .filter((f) => !f.data.duplicate_of && !isEntryOnly(f.id, f.data) && f.id !== 'night-gallery')
    .map((f) => ({ params: { slug: f.id }, props: { f } }));
}
interface Props { f: CollectionEntry<'films'> }
const { f } = Astro.props;
const d = f.data;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': d.kind === 'tv-series' ? 'TVSeries' : 'Movie',
  name: d.title,
  datePublished: d.release_date,
  director: d.directors.map((n) => ({ '@type': 'Person', name: n })),
  sameAs: d.ids?.imdb ? [`https://www.imdb.com/title/${d.ids.imdb}/`] : undefined,
};
---
<Base title={recordDocTitle('films', d, d.title)} description={`${d.title} and its connection to The Twilight Zone.`} jsonld={jsonld}>
  <FilmRecord f={f} />
</Base>
