---
import CategoryLanding from '../../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta, year } from '../../lib/landing';
// Night Gallery episodes have their own page (/night-gallery/); the series and pilot records appear here.
const films = (await getCollection('films')).filter((f) => !/^night-gallery-s\de\d\d$/.test(f.id) && !f.data.duplicate_of);
const items = films.map((f) => item('films', f.id, f.data.title, {
  href: `/films/${f.id}/`,
  meta: meta(year(f.data.release_date), f.data.parent_series, f.data.directors.length ? `dir. ${f.data.directors.slice(0, 2).join(', ')}` : undefined),
  desc: f.data.summary,
}));
---
<CategoryLanding category="films" items={items} lead={`${items.length} films, shows and episodes, plus every episode of Rod Serling's Night Gallery on its own page.`}>
  <p slot="before">Looking for Night Gallery episode by episode? See the <a href="/night-gallery/">Night Gallery guide</a>. For the evidence behind each link, see <a href="/influence/">Influence</a>.</p>
</CategoryLanding>
