---
import Base from '../layouts/Base.astro';
import FilmRecord from '../components/FilmRecord.astro';
import { getCollection, getEntry } from 'astro:content';
import { formatDate } from '../lib/data';
import { recordDocTitle } from '../lib/titles';

// Night Gallery has one page (Adam, 2026-11-21, decision 0002): the series record, then every
// broadcast episode and its segments in the episode explorer. The 1969 pilot film has its own page
// in Movies and is listed here too.
const series = (await getEntry('films', 'night-gallery'))!;
const pilot = await getEntry('films', 'night-gallery-pilot');
const films = await getCollection('films');
const eps = films.filter((f) => /^night-gallery-s\de\d\d$/.test(f.id));
const segCount = eps.reduce((t, e) => t + e.data.segments.length, 0);
const works = (await getCollection('works')).filter((w) => /night gallery/i.test(w.data.title));
const books = (await getCollection('books')).filter((b) => /night gallery/i.test(b.data.title));
// The extras, grouped by what they are, A to Z within each group.
const KIND_GROUP: Record<string, string> = { artwork: 'Paintings and art', prop: 'Paintings and art', soundtrack: 'Music', event: 'Awards and events', collectible: 'Collectibles', game: 'Games' };
const extras = [...works.map((w) => ({ g: /blu-ray|dvd|vhs|home video/i.test(w.data.title) ? 'Home video' : KIND_GROUP[w.data.kind] ?? 'More', title: w.data.title.replace(/^Night Gallery (painting|pilot painting|pilot portrait)?:?\s*/i, (m) => m), href: `/works/${w.id}/` })), ...books.map((b) => ({ g: 'Books', title: b.data.title, href: `/books/${b.id}/` }))];
const extraGroups = [...new Set(extras.map((x) => x.g))].sort().map((g) => [g, extras.filter((x) => x.g === g).sort((a, b) => a.title.localeCompare(b.title))] as const);
const jsonld = { '@context': 'https://schema.org', '@type': 'TVSeries', name: "Rod Serling's Night Gallery", startDate: '1969', creator: { '@type': 'Person', name: 'Rod Serling' } };
---
<Base title={recordDocTitle('films', series.data, "Rod Serling's Night Gallery")} description={`Rod Serling's Night Gallery (1969–1973): the pilot film and all ${eps.length} episodes and ${segCount} segments, with writers, directors, cast and the stories they adapt.`} jsonld={jsonld}>
  <FilmRecord f={series} title="Rod Serling's Night Gallery">
    <p>{eps.length} broadcast episodes hold {segCount} segments. Two more sketches were seen only in the syndicated version. Every one is below, under the season it aired in.</p>
    {pilot && (
      <section class="panel">
        <h2>The pilot film (1969)</h2>
        <p><a href={`/films/${pilot.id}/`}>{pilot.data.title}</a>{pilot.data.release_date && <span class="muted small"> · {formatDate(pilot.data.release_date)}</span>}</p>
        {pilot.data.segments.length > 0 && <p class="small">{pilot.data.segments.length} stories: {pilot.data.segments.map((sg) => sg.title).join(', ')}.</p>}
        <p class="small muted">A feature-length television film, so its own page is in Movies.</p>
      </section>
    )}
    {extras.length > 0 && (
      <section slot="after">
        <h2>More Night Gallery <span class="muted small">({extras.length})</span></h2>
        <div class="people-cols">
          {extraGroups.map(([g, list]) => (
            <div>
              <h3>{g} <span class="muted small">({list.length})</span></h3>
              <ul class="plain people-tally">{list.map((x) => <li><a href={x.href}>{x.title}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </section>
    )}
  </FilmRecord>
</Base>
