---
// The whole site on one page (the explore framework, 2026-11-28): the seven groups in Adam's order, the categories of
// Discover, View, Listen and Read (each a toggle on its group page), and the one table of Play, Collect and Legacy.
import Base from '../layouts/Base.astro';
import { navModel } from '../lib/nav';
import { groupTables } from '../lib/group-table';
const verbs = await navModel();
const tables = await groupTables();
const fmt = (n: number) => n.toLocaleString('en-US');
---
<Base title="Everything A to Z" description="Every group and category on IntoTheTwilightZone.com, with counts.">
  <p class="breadcrumb" data-pagefind-ignore><a href="/">Home</a></p>
  <h1>Everything on the site</h1>
  <p class="lead">Seven groups. Discover, View, Listen and Read each hold a table per category; Play, Collect and Legacy are one table each.</p>
  <p class="small muted">Reviews, interviews, clips, documents and other media appear on the pages they belong to, and all together in the <a href="/media/">Media Library</a>.</p>
  <div class="cat-index">
    {verbs.map((v) => (
      <section>
        <h2><a href={v.href}>{v.title}</a></h2>
        <p class="small muted">{v.blurb}</p>
        {v.cols.length > 0 ? (
          <ul class="plain">{v.cols.map((c) => <li><a href={c.href}>{c.title}</a> <span class="count-pill">{fmt(c.n)}</span></li>)}</ul>
        ) : (
          <p><a href={v.href}>One table of {fmt(tables.get(v.slug)?.rows.length ?? v.n)} entries</a></p>
        )}
      </section>
    ))}
  </div>
</Base>
