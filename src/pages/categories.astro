---
import Base from '../layouts/Base.astro';
import { catalog, countOf, type CatInfo } from '../lib/catalog';
import { sortKey, SECTIONS } from '../lib/taxonomy.mjs';
const all = [...(await catalog()).values()];
const sections = SECTIONS.map((s) => all.find((c) => c.slug === s.slug)!).filter(Boolean);
const cats = all.filter((c) => !c.kind || c.kind === 'category').sort((a, b) => sortKey(a.title).localeCompare(sortKey(b.title)));
const library = all.filter((c) => c.kind === 'library');
const block = (c: CatInfo) => c;
---
<Base title="All categories" description="Every section, category and subcategory on IntoTheTwilightZone.com, A to Z, with counts.">
  <p class="breadcrumb" data-pagefind-ignore><a href="/">Home</a></p>
  <h1>All categories</h1>
  <p class="lead">{sections.length} sections, {cats.length} categories and {[...sections, ...cats].reduce((n, c) => n + c.subs.length, 0)} subcategories. Those marked <span class="tag new">new</span> were added during research and are up for review.</p>
  <p>The site is organized in three layers. <strong>Sections</strong> are the people, places and organizations everything else links to. <strong>Categories</strong> are the things themselves, and most are split into official items (made, broadcast, licensed or published by the franchise or by Rod Serling) and unofficial items made by others about or inspired by the show. <strong>Content</strong> such as advertisements, archival holdings, documents and artwork attaches to the records it belongs to, and the <a href="/media/">Media library</a> gathers it in one place.</p>
  {[['Sections', sections], ['Categories', cats], ['Content', library]].map(([label, list]) => (
    <>
      <h2>{label}</h2>
      <div class="cat-index">
        {(list as CatInfo[]).map((c) => block(c)).map((c) => (
          <section>
            <h3><a href={`/${c.slug}/`}>{c.title}</a> {c.isNew && <span class="tag new">new</span>} <span class="muted small">({countOf(c).toLocaleString('en-US')})</span></h3>
            <p class="small muted">{c.description}</p>
            <ul class="plain">
              {c.subs.map((s) => <li>{s.entries.length ? <a href={`/${c.slug}/${s.slug}/`}>{s.title}</a> : <span class="muted">{s.title}</span>} <span class="count-pill">{s.entries.length}</span>{s.isNew && !c.isNew && <span class="tag new">new</span>}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </>
  ))}
</Base>
