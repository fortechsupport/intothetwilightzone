---
import CategoryLanding from '../../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta } from '../../lib/landing';
import { placeLine } from '../../lib/places';
const places = (await getCollection('locations')).filter((p) => !p.data.duplicate_of);
const items = places.map((p) => item('locations', p.id, p.data.name, {
  href: `/places/${p.id}/`,
  meta: meta(placeLine(p.data), p.data.status),
  desc: p.data.notes,
}));
---
<CategoryLanding category="locations" items={items} lead={`${items.length} places where the show was made, where Rod Serling lived and worked, and where the Twilight Zone lives on.`} />
