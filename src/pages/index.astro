---
import Base from '../layouts/Base.astro';
import TodayPanel from '../components/fan/TodayPanel.astro';
import { catalog, countOf, mediaLibrary } from '../lib/catalog';
import { SECTIONS, GROUPS, groupHref, LIBRARY_TYPES } from '../lib/taxonomy.mjs';
const cat = await catalog();
const all = [...cat.values()];
const sections = SECTIONS.map((s) => all.find((c) => c.slug === s.slug)!).filter(Boolean);
const groups = GROUPS.map((g) => ({ ...g, cats: g.categories.map((c) => cat.get(c.slug)).filter(Boolean) as typeof all }));
const lib = await mediaLibrary();
const libCounts = LIBRARY_TYPES.map(([k, label]) => [k, label, lib.filter((i) => i.type === k).length] as const).filter(([, , n]) => n);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'IntoTheTwilightZone.com',
  url: 'https://intothetwilightzone.com/',
  potentialAction: { '@type': 'SearchAction', target: 'https://intothetwilightzone.com/search/?q={query}', 'query-input': 'required name=query' },
};
---
<Base title="Home" jsonld={jsonld}>
  <section class="hero">
    <h1>A living history of The Twilight Zone</h1>
    <p class="lead">
      Every series, every episode, the people who made them, and the films, songs, books and stories
      they went on to inspire. Fan-curated, sourced, and free of advertising.
    </p>
  </section>

  <nav class="fan-ctas" aria-label="Ways in" data-pagefind-ignore>
    <a class="cta primary" href="/start/">New to the Zone? Start here</a>
    <a class="cta" href="/paths/">Viewing paths</a>
    <a class="cta" href="/finder/">Episode finder</a>
    <a class="cta" href="/map/">Map</a>
    <a class="cta" href="/timeline/">Timeline</a>
    <a class="cta" href="/degrees/">Six degrees</a>
    <a class="cta" href="/my-zone/">My Zone</a>
  </nav>
  <TodayPanel compact />

  <h2>People, places and organizations</h2>
  <p class="small muted">The directories everything else links to. Each has a sortable, filterable index showing every page an entry appears on.</p>
  <div class="grid">
    {sections.map((c) => (
      <a class="card" href={`/${c.slug}/`}>
        <span class="count">{countOf(c).toLocaleString('en-US')}</span>
        <h3>{c.title}{c.isNew && <span class="tag new">new</span>}</h3>
        <p>{c.subs.filter((x) => x.entries.length).map((x) => x.title).join(' · ')}</p>
      </a>
    ))}
    <a class="card" href="/media/">
      <span class="count">{lib.length.toLocaleString('en-US')}</span>
      <h3>Media Library</h3>
      <p>{libCounts.map(([, l, n]) => `${l} (${n.toLocaleString('en-US')})`).join(' · ')}</p>
    </a>
  </div>

  <h2>Explore</h2>
  <p class="small muted">Categories grouped by medium. Each category is split into official items and unofficial or inspired ones. Reviews, interviews, documents, advertisements and other media appear on the pages they belong to and all together in the <a href="/media/">Media Library</a>. <a href="/categories/">See every subcategory</a>.</p>
  {groups.map((g) => (
    <section class="group-block">
      <h3><a href={groupHref(g)}>{g.title}</a></h3>
      <p class="small muted">{g.blurb}</p>
      <div class="grid">
        {g.cats.map((c) => (
          <a class="card" href={`/${c.slug}/`}>
            <span class="count">{countOf(c).toLocaleString('en-US')}</span>
            <h3>{c.title}{c.isNew && <span class="tag new">new</span>}</h3>
            <p>{c.subs.filter((x) => x.entries.length).map((x) => x.title).join(' · ')}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
  <h2>Features</h2>
  <ul>
    <li><a href="/rod-serling/">Rod Serling</a>: his life and work beyond The Twilight Zone.</li>
    <li><a href="/night-gallery/">Night Gallery</a>: every episode and segment of Serling's second anthology.</li>
    <li><a href="/timeline/">Timeline</a>: the franchise year by year.</li>
  </ul>

  <h2>About this site</h2>
  <p>
    IntoTheTwilightZone.com documents the franchise and its long shadow across film, television, music and
    print. Facts come with sources; connections between works are labelled by how well they are documented.
    Spotted an error? <a href="/about/#contact">Send a correction</a>.
  </p>
</Base>
