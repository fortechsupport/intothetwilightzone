---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { allEpisodes, allPeople } from '../lib/data';

const episodes = await allEpisodes();
const people = await allPeople();
const counts = {
  films: (await getCollection('films')).length,
  connections: (await getCollection('connections')).length,
  songs: (await getCollection('songs')).length,
  radio: (await getCollection('radio')).length,
  books: (await getCollection('books')).length,
  comics: (await getCollection('comics')).length,
  magazines: (await getCollection('magazines')).length,
  podcasts: (await getCollection('podcasts')).length,
};
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'IntoTheTwilightZone.com',
  url: 'https://intothetwilightzone.com/',
  potentialAction: { '@type': 'SearchAction', target: 'https://intothetwilightzone.com/search/?q={query}', 'query-input': 'required name=query' },
};
---
<Base title="Home" jsonld={jsonld}>
  <section class="hero">
    <h1>A living history of The Twilight Zone</h1>
    <p class="lead">
      Every series, every episode, the people who made them, and the films, songs, books and stories
      they went on to inspire. Fan-curated, sourced, and free of advertising.
    </p>
  </section>

  <h2>Explore</h2>
  <div class="grid">
    <a class="card" href="/series/"><span class="count">{episodes.length}</span><h3>Episodes</h3><p>All four series: 1959, 1985, 2002 and 2019.</p></a>
    <a class="card" href="/people/"><span class="count">{people.size}</span><h3>People</h3><p>Writers, directors, cast and narrators.</p></a>
    <a class="card" href="/influence/"><span class="count">{counts.connections}</span><h3>Influence</h3><p>Later works traced back to the episodes behind them.</p></a>
    <a class="card" href="/films/"><span class="count">{counts.films}</span><h3>Films</h3><p>Adaptations, homages and films inspired by episodes.</p></a>
    <a class="card" href="/songs/"><span class="count">{counts.songs}</span><h3>Songs</h3><p>Theme music and songs that mention or reference the show.</p></a>
    <a class="card" href="/radio/"><span class="count">{counts.radio}</span><h3>Radio dramas</h3><p>Full-cast audio adaptations of classic episodes.</p></a>
    <a class="card" href="/books/"><span class="count">{counts.books}</span><h3>Books</h3><p>Histories, companions and story collections.</p></a>
    <a class="card" href="/comics/"><span class="count">{counts.comics}</span><h3>Comics</h3><p>From Dell and Gold Key to modern runs.</p></a>
    <a class="card" href="/magazines/"><span class="count">{counts.magazines}</span><h3>Magazines</h3><p>Rod Serling's The Twilight Zone Magazine and more.</p></a>
    <a class="card" href="/podcasts/"><span class="count">{counts.podcasts}</span><h3>Podcasts</h3><p>Shows that revisit the series episode by episode.</p></a>
  </div>

  <h2>About this site</h2>
  <p>
    IntoTheTwilightZone.com documents the franchise and its long shadow across film, television, music and
    print. Facts come with sources; connections between works are labelled by how well they are documented.
    Spotted an error? <a href="/about/#contact">Send a correction</a>.
  </p>
</Base>
