---
import Base from '../layouts/Base.astro';
import { catalog, countOf } from '../lib/catalog';
import { sortKey, SECTIONS } from '../lib/taxonomy.mjs';
const all = [...(await catalog()).values()];
const sections = SECTIONS.map((s) => all.find((c) => c.slug === s.slug)!).filter(Boolean);
const cats = all.filter((c) => !c.kind || c.kind === 'category').sort((x, y) => sortKey(x.title).localeCompare(sortKey(y.title)));
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'IntoTheTwilightZone.com',
  url: 'https://intothetwilightzone.com/',
  potentialAction: { '@type': 'SearchAction', target: 'https://intothetwilightzone.com/search/?q={query}', 'query-input': 'required name=query' },
};
---
<Base title="Home" jsonld={jsonld}>
  <section class="hero">
    <h1>A living history of The Twilight Zone</h1>
    <p class="lead">
      Every series, every episode, the people who made them, and the films, songs, books and stories
      they went on to inspire. Fan-curated, sourced, and free of advertising.
    </p>
  </section>

  <h2>People, places and organizations</h2>
  <div class="grid">
    {sections.map((c) => (
      <a class="card" href={`/${c.slug}/`}>
        <span class="count">{countOf(c).toLocaleString('en-US')}</span>
        <h3>{c.title}{c.isNew && <span class="tag new">new</span>}</h3>
        <p>{c.subs.filter((x) => x.entries.length).map((x) => x.title).join(' · ')}</p>
      </a>
    ))}
  </div>
  <h2>Explore by category</h2>
  <p class="small muted">Every category, A to Z, each split into official items and unofficial or inspired ones. Those marked <span class="tag new">new</span> were added during research. Advertisements, archival holdings and documents are on the records they belong to, and all together in the <a href="/media/">Media library</a>. <a href="/categories/">See every subcategory</a>.</p>
  <div class="grid">
    {cats.map((c) => (
      <a class="card" href={`/${c.slug}/`}>
        <span class="count">{countOf(c).toLocaleString('en-US')}</span>
        <h3>{c.title}{c.isNew && <span class="tag new">new</span>}</h3>
        <p>{c.subs.filter((x) => x.entries.length).map((x) => x.title).join(' · ')}</p>
      </a>
    ))}
  </div>
  <h2>Features</h2>
  <ul>
    <li><a href="/rod-serling/">Rod Serling</a>: his life and work beyond The Twilight Zone.</li>
    <li><a href="/night-gallery/">Night Gallery</a>: every episode and segment of Serling's second anthology.</li>
    <li><a href="/timeline/">Timeline</a>: the franchise year by year.</li>
  </ul>

  <h2>About this site</h2>
  <p>
    IntoTheTwilightZone.com documents the franchise and its long shadow across film, television, music and
    print. Facts come with sources; connections between works are labelled by how well they are documented.
    Spotted an error? <a href="/about/#contact">Send a correction</a>.
  </p>
</Base>
