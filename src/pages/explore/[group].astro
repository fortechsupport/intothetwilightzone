---
// A grouping of categories (Screen, Audio, Live and experiences, Art and collectibles): each category with
// its subcategories and counts, then the people, places, organizations and media across the group.
import Base from '../../layouts/Base.astro';
import SectionSummary from '../../components/SectionSummary.astro';
import { catalog, countOf } from '../../lib/catalog';
import { GROUPS } from '../../lib/taxonomy.mjs';

export async function getStaticPaths() {
  return GROUPS.filter((g) => g.categories.length > 1).map((g) => ({ params: { group: g.slug }, props: { slug: g.slug } }));
}
const { slug } = Astro.props as { slug: string };
const g = GROUPS.find((x) => x.slug === slug)!;
const all = await catalog();
const cats = g.categories.map((c) => all.get(c.slug)!).filter(Boolean);
const entries = [...new Map(cats.flatMap((c) => c.subs.flatMap((s) => s.entries.map((e) => [e.key, e])))).values()];
---
<Base title={g.title} description={`${g.title}: ${g.blurb}`}>
  <p class="breadcrumb" data-pagefind-ignore><a href="/">Home</a> / <a href="/categories/">All categories</a></p>
  <h1>{g.title}</h1>
  <p class="lead">{g.blurb} {entries.length.toLocaleString('en-US')} entries in {cats.length} categories, each split into official items and unofficial or inspired ones.</p>
  <div class="grid">
    {cats.map((c) => (
      <a class="card" href={`/${c.slug}/`}>
        <span class="count">{countOf(c).toLocaleString('en-US')}</span>
        <h3>{c.title}{c.isNew && <span class="tag new">new</span>}</h3>
        <p>{c.description}</p>
        <p class="small muted">{c.subs.filter((s) => s.entries.length).map((s) => s.title).join(' · ')}</p>
      </a>
    ))}
  </div>
  <SectionSummary entries={entries} label={g.title} />
</Base>
