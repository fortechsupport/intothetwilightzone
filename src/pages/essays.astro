---
import CategoryLanding from '../components/CategoryLanding.astro';
import { getCollection } from 'astro:content';
import { item, meta, year } from '../lib/landing';
const essays = (await getCollection('essays')).filter((e) => !e.data.duplicate_of);
const items = essays.map((e) => item('essays', e.id, e.data.title, {
  href: e.data.links?.online,
  meta: meta(e.data.authors.join(', '), e.data.published_in, year(e.data.published)),
  desc: e.data.description,
}));
---
<CategoryLanding category="essays" items={items} lead={`${items.length} pieces of writing: scholarship, criticism, interviews and Rod Serling's own speeches.`} />
