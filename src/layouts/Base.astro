---
interface Props {
  title: string;
  description?: string;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
}
import { reviewMode } from '../lib/review';
const preview = reviewMode() !== 'public';
const { title, description = 'An independent, non-commercial living history of The Twilight Zone: every series, episode, person, and the films, songs and stories it inspired.', jsonld, noindex } = Astro.props;
const fullTitle = title === 'Home' ? 'IntoTheTwilightZone.com' : `${title} · IntoTheTwilightZone.com`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Navigation (Adam, 2026-11-21). The main bar is the nine verbs, each opening a panel of its categories
// and their subcategories with counts (model in src/lib/nav.ts). The utility bar above holds the features;
// its links and the footer's live in src/lib/site-links.ts. On phones the verbs fold into one Menu button.
import { navModel } from '../lib/nav';
const verbs = await navModel();
import { UTILITY_LINKS, FOOTER_COLUMNS, FOOTER_LINKS } from '../lib/site-links';
import AccountSlot from '../components/AccountSlot.astro';
const nav = UTILITY_LINKS;
// Record pages belong to a verb too, so its tab is marked while you read one.
const RECORD_VERB: Record<string, string> = { series: 'watch', episodes: 'watch', films: 'watch', '1959series': 'watch', '1985series': 'watch', '2002series': 'watch', '2019series': 'watch', songs: 'listen', books: 'read', comics: 'read', magazines: 'read', essays: 'read', characters: 'meet' };
const path = Astro.url.pathname;
import { correctionUrl } from '../lib/fan/contribute';
// One "Type" filter for site search, from the first part of the address.
const TYPE_LABEL: Record<string, string> = {
  episodes: 'Episodes', series: 'Series', films: 'Movies and screen', people: 'People', characters: 'Characters', places: 'Places',
  organizations: 'Organizations', books: 'Reading', comics: 'Reading', magazines: 'Reading', essays: 'Reading', archives: 'Archives',
  songs: 'Music', radio: 'Radio', podcasts: 'Podcasts', works: 'Other works', quotes: 'Quotes', paths: 'Guides', media: 'Media',
};
const searchType = TYPE_LABEL[path.split('/')[1] ?? ''] ?? (path === '/' ? undefined : 'Guides and indexes');
const first = path.split('/')[1] ?? '';
const hereVerb = verbs.find((v) => path.startsWith(v.href) || v.cols.some((c) => path.startsWith(c.href)) || (v.collections ?? []).some((c) => path.startsWith(c.href)))?.slug ?? RECORD_VERB[first];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || preview) && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content="IntoTheTwilightZone.com" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-default.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#08090f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3eee2" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/jost-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-serif-display-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Apply a saved theme before the first paint (Midnight is the default; Paper is the light theme).
      try { const t = localStorage.getItem('tz-theme'); if (t === 'paper' || t === 'midnight') document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <link rel="stylesheet" href="/tokens.css" />
    <link rel="stylesheet" href="/site.css" />
    <link rel="stylesheet" href="/fan.css" />
    <link rel="stylesheet" href="/account.css" />
    <script is:inline src="/fan.js" defer></script>
    <script is:inline src="/account.js" defer></script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {preview && <div class="preview-banner" data-pagefind-ignore>Preview build: includes records still pending review. <a href="/review/">Open the review queue</a></div>}
    <header class="site-header">
      <div class="util-bar">
        <div class="wrap util-inner">
          <nav aria-label="Features">
            <ul>
              {nav.map(([label, href]) => (
                <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>
              ))}
            </ul>
          </nav>
          <div class="util-end">
            <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch between dark and light theme">Light</button>
            <AccountSlot />
          </div>
        </div>
      </div>
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label="IntoTheTwilightZone.com home">
          <span class="brand-mark">Into <em>the</em> Twilight Zone</span>
          <span class="brand-sub">A living history</span>
        </a>
        <nav class="verbs" id="verbs-bar" aria-label="Watch, listen, read and more">
          <ul>
            {verbs.map((v) => (
              <li class="group">
                <details>
                  <summary aria-current={hereVerb === v.slug ? 'page' : undefined}>{v.title}</summary>
                  <div class={`mega${(v.menu ?? v.cols).every((c) => !c.subs.length) ? ' flat' : ''}`}>
                    <div class="mega-inner">
                      <div class="mega-head">
                        <a href={v.href}>All of {v.title} →</a>
                        <span class="muted">{v.blurb}</span>
                      </div>
                      <div class="mega-cols">
                        {(v.menu ?? v.cols).map((c) => (
                          <div class="mega-col">
                            <a class="mega-cat" href={c.href}>{c.title}{c.isNew && <span class="tag new">new</span>}</a> {!('live' in c && c.live) && <span class="n">{c.n}</span>}
                            {c.subs.length > 0 && <ul>{c.subs.map((x) => <li><a href={x.href}>{x.title}</a> {!('live' in c && c.live) && <span class="n">{x.n}</span>}</li>)}</ul>}
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </details>
              </li>
            ))}
          </ul>
          <ul class="mobile-util">
            {nav.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
            <li><AccountSlot compact /></li>
            <li><button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch between dark and light theme">Light</button></li>
          </ul>
        </nav>
        <a class="icon-btn header-search" href="/search/" aria-label="Search the site">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <span class="label">Search</span>
        </a>
        <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="verbs-bar">Menu</button>
      </div>
    </header>
    <script is:inline>
      // One menu open at a time; close on outside click or Escape. On phones the Menu button shows the verbs.
      (() => {
        const ds = [...document.querySelectorAll('.verbs details')];
        ds.forEach((d) => d.addEventListener('toggle', () => { if (d.open) ds.forEach((o) => o !== d && (o.open = false)); }));
        document.addEventListener('click', (e) => { if (!e.target.closest('.verbs')) ds.forEach((d) => (d.open = false)); });
        const t = document.querySelector('.menu-toggle'), bar = document.getElementById('verbs-bar');
        const setOpen = (open) => { bar.classList.toggle('open', open); t.setAttribute('aria-expanded', String(open)); t.textContent = open ? 'Close' : 'Menu'; };
        t?.addEventListener('click', (e) => { e.stopPropagation(); setOpen(!bar.classList.contains('open')); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { ds.forEach((d) => (d.open = false)); if (bar.classList.contains('open')) { setOpen(false); t.focus(); } } });
        // Theme switch: remembers the choice in this browser.
        const root = document.documentElement;
        const current = () => root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'paper' : 'midnight');
        const label = () => document.querySelectorAll('[data-theme-toggle]').forEach((b) => { const light = current() === 'paper'; b.textContent = light ? 'Dark' : 'Light'; b.setAttribute('aria-pressed', String(light)); });
        document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', () => {
          const next = current() === 'paper' ? 'midnight' : 'paper';
          root.dataset.theme = next;
          try { localStorage.setItem('tz-theme', next); } catch (e) {}
          label();
        }));
        label();
      })();
    </script>
    <main id="main" class="wrap" data-pagefind-body={noindex ? undefined : ''}>
      {!noindex && searchType && <span hidden data-pagefind-ignore><span data-pagefind-filter="Type">{searchType}</span></span>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <span class="brand-mark">Into <em>the</em> Twilight Zone</span>
            <p>An independent, non-commercial fan history of The Twilight Zone and everything it inspired. Every fact carries a source.</p>
            <p><a href={correctionUrl(canonical.href, path)} rel="noopener">Suggest a correction to this page</a></p>
          </div>
          {FOOTER_COLUMNS.map((col) => (
            <nav aria-label={col.title}>
              <h2>{col.title}</h2>
              <ul>
                {col.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
                {col.title === 'This site' && FOOTER_LINKS.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
              </ul>
            </nav>
          ))}
        </div>
        <p class="disclaimer">
          IntoTheTwilightZone.com is an independent, non-commercial fan site. It is not affiliated with,
          endorsed by, or sponsored by CBS Studios, Paramount, the Rod Serling estate, or any rights holder.
          The Twilight Zone is a trademark of CBS Studios Inc. All other trademarks and copyrighted works belong
          to their respective owners and are referenced for commentary, criticism and historical documentation.
          Rights holders can request corrections or removal through the <a href="/contribute/#rights">contribute page</a>.
        </p>
      </div>
    </footer>
    <span id="ext-note" hidden>opens in a new tab</span>
  </body>
</html>
