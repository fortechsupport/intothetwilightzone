---
interface Props {
  title: string;
  description?: string;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
}
import { reviewMode } from '../lib/review';
const preview = reviewMode() !== 'public';
const { title, description = 'An independent, non-commercial living history of The Twilight Zone: every series, episode, person, and the films, songs and stories it inspired.', jsonld, noindex } = Astro.props;
const fullTitle = title === 'Home' ? 'IntoTheTwilightZone.com' : `${title} · IntoTheTwilightZone.com`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Main navigation: the directories (People, Places, Organizations) and the Media Library up top, the
// category groupings in an Explore menu, then search.
import { GROUPS, groupHref } from '../lib/taxonomy.mjs';
const nav = [
  ['Start here', '/start/'],
  ['People', '/people/'],
  ['Places', '/places/'],
  ['Organizations', '/organizations/'],
  ['Media Library', '/media/'],
  ['Search', '/search/'],
];
const path = Astro.url.pathname;
import { correctionUrl } from '../lib/fan/contribute';
// One "Type" filter for site search, from the first part of the address.
const TYPE_LABEL: Record<string, string> = {
  episodes: 'Episodes', series: 'Series', films: 'Movies and screen', people: 'People', characters: 'Characters', places: 'Places',
  organizations: 'Organizations', books: 'Reading', comics: 'Reading', magazines: 'Reading', essays: 'Reading', archives: 'Archives',
  songs: 'Music', radio: 'Radio', podcasts: 'Podcasts', works: 'Other works', quotes: 'Quotes', paths: 'Guides', media: 'Media',
};
const searchType = TYPE_LABEL[path.split('/')[1] ?? ''] ?? (path === '/' ? undefined : 'Guides and indexes');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || preview) && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/site.css" />
    <link rel="stylesheet" href="/fan.css" />
    <script is:inline src="/fan.js" defer></script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {preview && <div class="preview-banner" data-pagefind-ignore>Preview build: shows records that are still pending review. <a href="/review/">Open the review queue</a></div>}
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">Into<span>The</span>TwilightZone<small>.com</small></a>
        <nav aria-label="Main">
          <ul>
            <li class="menu">
              <details>
                <summary>Explore</summary>
                <ul class="menu-list">
                  {GROUPS.map((g) => (
                    <li class="menu-group">
                      <a class="menu-group-title" href={groupHref(g)}>{g.title}</a>
                      {(g.categories.length > 1 || g.categories[0].title !== g.title) && <ul>{g.categories.map((c) => <li><a href={`/${c.slug}/`} aria-current={path.startsWith(`/${c.slug}/`) ? 'page' : undefined}>{c.title}{c.isNew && <span class="tag new">new</span>}</a></li>)}</ul>}
                    </li>
                  ))}
                  <li class="menu-group"><span class="menu-group-title">Features</span><ul><li><a href="/rod-serling/">Rod Serling</a></li><li><a href="/night-gallery/">Night Gallery</a></li><li><a href="/timeline/">Timeline</a></li></ul></li>
                  <li class="menu-all"><a href="/categories/">Everything, with every subcategory</a></li>
                </ul>
              </details>
            </li>
            {nav.map(([label, href]) => (
              <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap" data-pagefind-body={noindex ? undefined : ''}>
      {!noindex && searchType && <span hidden data-pagefind-ignore><span data-pagefind-filter="Type">{searchType}</span></span>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer">
          IntoTheTwilightZone.com is an independent, non-commercial fan site. It is not affiliated with,
          endorsed by, or sponsored by CBS Studios, Paramount, the Rod Serling estate, or any rights holder.
          The Twilight Zone is a trademark of CBS Studios Inc. All other trademarks and copyrighted works belong
          to their respective owners and are referenced for commentary, criticism and historical documentation.
          Rights holders can request corrections or removal through the <a href="/contribute/#rights">contribute page</a>.
        </p>
        <p class="footer-links"><a href="/about/">About</a> · <a href="/sources/">Sources and policy</a> · <a href={correctionUrl(canonical.href, path)} rel="noopener">Suggest a correction to this page</a> · <a href="/contribute/">Contribute</a> · <a href="/start/">Start here</a> · <a href="/my-zone/">My Zone</a></p>
      </div>
    </footer>
  </body>
</html>
