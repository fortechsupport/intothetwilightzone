---
interface Props {
  title: string;
  description?: string;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
}
import { reviewMode } from '../lib/review';
const preview = reviewMode() !== 'public';
const { title, description = 'An independent, non-commercial living history of The Twilight Zone: every series, episode, person, and the films, songs and stories it inspired.', jsonld, noindex } = Astro.props;
const fullTitle = title === 'Home' ? 'IntoTheTwilightZone.com' : `${title} · IntoTheTwilightZone.com`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Navigation (Adam, 2026-11-21). The main bar is the nine verbs, each opening a panel of its categories
// and their subcategories with counts (model in src/lib/nav.ts). The utility bar above holds Search, the
// Media Library and the features; add utility links to `nav`. On phones the verbs fold into one Menu button.
import { navModel } from '../lib/nav';
const verbs = await navModel();
const nav = [
  ['Start here', '/start/'],
  ['Search', '/search/'],
  ['Media Library', '/media/'],
  ['Timeline', '/timeline/'],
  ['Rod Serling', '/rod-serling/'],
  ['Night Gallery', '/night-gallery/'],
  ['Everything A to Z', '/categories/'],
  ['About', '/about/'],
];
// Record pages belong to a verb too, so its tab is marked while you read one.
const RECORD_VERB: Record<string, string> = { series: 'watch', episodes: 'watch', films: 'watch', '1959series': 'watch', '1985series': 'watch', '2002series': 'watch', '2019series': 'watch', songs: 'listen', books: 'read', comics: 'read', magazines: 'read', essays: 'read', characters: 'meet' };
const path = Astro.url.pathname;
import { correctionUrl } from '../lib/fan/contribute';
import AccountSlot from '../components/AccountSlot.astro';
// One "Type" filter for site search, from the first part of the address.
const TYPE_LABEL: Record<string, string> = {
  episodes: 'Episodes', series: 'Series', films: 'Movies and screen', people: 'People', characters: 'Characters', places: 'Places',
  organizations: 'Organizations', books: 'Reading', comics: 'Reading', magazines: 'Reading', essays: 'Reading', archives: 'Archives',
  songs: 'Music', radio: 'Radio', podcasts: 'Podcasts', works: 'Other works', quotes: 'Quotes', paths: 'Guides', media: 'Media',
};
const searchType = TYPE_LABEL[path.split('/')[1] ?? ''] ?? (path === '/' ? undefined : 'Guides and indexes');
const first = path.split('/')[1] ?? '';
const hereVerb = verbs.find((v) => path.startsWith(v.href) || v.cols.some((c) => path.startsWith(c.href)) || (v.collections ?? []).some((c) => path.startsWith(c.href)))?.slug ?? RECORD_VERB[first];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || preview) && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/site.css" />
    <link rel="stylesheet" href="/fan.css" />
    <script is:inline src="/fan.js" defer></script>
    <link rel="stylesheet" href="/account.css" />
    <script is:inline src="/account.js" defer></script>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {preview && <div class="preview-banner" data-pagefind-ignore>Preview build: shows records that are still pending review. <a href="/review/">Open the review queue</a></div>}
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">Into<span>The</span>TwilightZone<small>.com</small></a>
        <nav class="utility" aria-label="Search and features">
          <ul>
            {nav.map(([label, href]) => (
              <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>
            ))}
            <li><AccountSlot /></li>
          </ul>
        </nav>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="verbs-bar">Menu</button>
      </div>
      <nav class="groups-bar" id="verbs-bar" aria-label="Watch, listen, read and more">
        <ul class="wrap groups">
          {verbs.map((v) => (
            <li class="group">
              <details>
                <summary aria-current={hereVerb === v.slug ? 'page' : undefined}>{v.title}</summary>
                <div class={`mega${(v.menu ?? v.cols).every((c) => !c.subs.length) ? ' flat' : ''}`}>
                  <div class="mega-head">
                    <a href={v.href}><strong>All of {v.title} →</strong></a>
                    <span class="muted small">{v.blurb}</span>
                  </div>
                  <div class="mega-cols">
                    {(v.menu ?? v.cols).map((c) => (
                      <div class="mega-col">
                        <a class="mega-cat" href={c.href}>{c.title}{c.isNew && <span class="tag new">new</span>}</a> <span class="n">{c.n}</span>
                        {c.subs.length > 0 && <ul>{c.subs.map((x) => <li><a href={x.href}>{x.title}</a> <span class="n">{x.n}</span></li>)}</ul>}
                      </div>
                    ))}
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ul>
        <ul class="wrap mobile-util">{nav.map(([label, href]) => <li><a href={href}>{label}</a></li>)}<li><AccountSlot /></li></ul>
      </nav>
    </header>
    <script is:inline>
      // One menu open at a time; close on outside click or Escape. On phones the Menu button shows the verbs.
      (() => {
        const ds = [...document.querySelectorAll('.groups-bar details')];
        ds.forEach((d) => d.addEventListener('toggle', () => { if (d.open) ds.forEach((o) => o !== d && (o.open = false)); }));
        document.addEventListener('click', (e) => { if (!e.target.closest('.groups-bar')) ds.forEach((d) => (d.open = false)); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') ds.forEach((d) => (d.open = false)); });
        const t = document.querySelector('.menu-toggle'), bar = document.getElementById('verbs-bar');
        t?.addEventListener('click', (e) => { e.stopPropagation(); const open = bar.classList.toggle('open'); t.setAttribute('aria-expanded', String(open)); });
      })();
    </script>
    <main id="main" class="wrap" data-pagefind-body={noindex ? undefined : ''}>
      {!noindex && searchType && <span hidden data-pagefind-ignore><span data-pagefind-filter="Type">{searchType}</span></span>}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer">
          IntoTheTwilightZone.com is an independent, non-commercial fan site. It is not affiliated with,
          endorsed by, or sponsored by CBS Studios, Paramount, the Rod Serling estate, or any rights holder.
          The Twilight Zone is a trademark of CBS Studios Inc. All other trademarks and copyrighted works belong
          to their respective owners and are referenced for commentary, criticism and historical documentation.
          Rights holders can request corrections or removal through the <a href="/contribute/#rights">contribute page</a>.
        </p>
        <p class="footer-links"><a href="/about/">About</a> · <a href="/sources/">Sources and policy</a> · <a href={correctionUrl(canonical.href, path)} rel="noopener">Suggest a correction to this page</a> · <a href="/contribute/">Contribute</a> · <a href="/community/">Community</a> · <a href="/start/">Start here</a> · <a href="/my-zone/">My Zone</a> · <a href="/terms/">Terms</a> · <a href="/privacy/">Privacy</a> · <a href="/copyright/">Copyright</a></p>
      </div>
    </footer>
  </body>
</html>
