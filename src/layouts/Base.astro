---
interface Props {
  title: string;
  description?: string;
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
}
import { reviewMode } from '../lib/review';
const preview = reviewMode() !== 'public';
const { title, description = 'An independent, non-commercial living history of The Twilight Zone: every series, episode, person, and the films, songs and stories it inspired.', jsonld, noindex } = Astro.props;
const fullTitle = title === 'Home' ? 'IntoTheTwilightZone.com' : `${title} · IntoTheTwilightZone.com`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Navigation. The primary bar is the seven category groups (Screen, Audio, Print...), each opening a
// panel of its categories and their subcategories. The utility bar above it holds the directories,
// the Media Library and the features; add utility links to `nav`.
import { GROUPS, groupHref } from '../lib/taxonomy.mjs';
import { catalog } from '../lib/catalog';
const cats = await catalog();
const groupsNav = GROUPS.map((g) => ({
  ...g,
  href: groupHref(g),
  cats: g.categories.map((c) => cats.get(c.slug)).filter(Boolean).map((c) => ({ slug: c!.slug, title: c!.title, isNew: c!.isNew, subs: c!.subs.filter((x) => x.entries.length).map((x) => ({ slug: x.slug, title: x.title, n: x.entries.length })) })),
}));
const nav = [
  ['People', '/people/'],
  ['Places', '/places/'],
  ['Organizations', '/organizations/'],
  ['Media Library', '/media/'],
  ['Rod Serling', '/rod-serling/'],
  ['Night Gallery', '/night-gallery/'],
  ['Timeline', '/timeline/'],
  ['All categories', '/categories/'],
  ['Search', '/search/'],
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || preview) && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/site.css" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {preview && <div class="preview-banner" data-pagefind-ignore>Preview build: shows records that are still pending review. <a href="/review/">Open the review queue</a></div>}
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">Into<span>The</span>TwilightZone<small>.com</small></a>
        <nav class="utility" aria-label="Directories and features">
          <ul>
            {nav.map(([label, href]) => (
              <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <nav class="groups-bar" aria-label="Categories">
        <ul class="wrap groups">
          {groupsNav.map((g) => {
            const here = g.cats.some((c) => path.startsWith(`/${c.slug}/`)) || path.startsWith(`/explore/${g.slug}/`);
            return (
              <li class="group">
                <details>
                  <summary aria-current={here ? 'page' : undefined}>{g.title}</summary>
                  <div class={`mega${g.cats.length === 1 ? ' single' : ''}`}>
                    <div class="mega-head">
                      <a href={g.href}><strong>{g.cats.length > 1 ? `All of ${g.title}` : `All of ${g.cats[0]?.title}`} →</strong></a>
                      <span class="muted small">{g.blurb}</span>
                    </div>
                    <div class="mega-cols">
                      {g.cats.map((c) => (
                        <div class="mega-col">
                          {g.cats.length > 1 && <a class="mega-cat" href={`/${c.slug}/`}>{c.title}{c.isNew && <span class="tag new">new</span>}</a>}
                          <ul>{c.subs.map((x) => <li><a href={`/${c.slug}/${x.slug}/`}>{x.title}</a> <span class="n">{x.n}</span></li>)}</ul>
                        </div>
                      ))}
                    </div>
                  </div>
                </details>
              </li>
            );
          })}
        </ul>
      </nav>
    </header>
    <script is:inline>
      // One menu open at a time; close on outside click or Escape.
      (() => {
        const ds = [...document.querySelectorAll('.groups-bar details')];
        ds.forEach((d) => d.addEventListener('toggle', () => { if (d.open) ds.forEach((o) => o !== d && (o.open = false)); }));
        document.addEventListener('click', (e) => { if (!e.target.closest('.groups-bar')) ds.forEach((d) => (d.open = false)); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') ds.forEach((d) => (d.open = false)); });
      })();
    </script>
    <main id="main" class="wrap" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="disclaimer">
          IntoTheTwilightZone.com is an independent, non-commercial fan site. It is not affiliated with,
          endorsed by, or sponsored by CBS Studios, Paramount, the Rod Serling estate, or any rights holder.
          The Twilight Zone is a trademark of CBS Studios Inc. All other trademarks and copyrighted works belong
          to their respective owners and are referenced for commentary, criticism and historical documentation.
          Rights holders can request corrections or removal through the <a href="/about/#contact">contact details</a>.
        </p>
        <p class="footer-links"><a href="/about/">About</a> · <a href="/sources/">Sources and policy</a> · <a href="/about/#contact">Contact and corrections</a></p>
      </div>
    </footer>
  </body>
</html>
